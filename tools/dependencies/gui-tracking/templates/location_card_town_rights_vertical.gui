# vanilla: in_game/gui/location_window.gui
# mod: in_game/gui/location_window.gui

template location_card_town_rights_vertical {
	block "location_card_town_rights_size" {
		size = { 33 33 }
	}
	visible = "[Or(GreaterThan_int32(GetDataModelSize(Location.GetTownRights), '(int32)0'), And(Location.GetOwner.IsPlayer, Not(Location.GetRank.IsDefault)))]"
	block "location_card_town_rights_enabled" {
		enabled = "[And(ShowGrantLocationTownRights(Location.Self), Not(Location.GetRank.IsDefault))]"
	}

	block "location_card_town_rights_empty_button" {
		button_townrights = {
			using = location_card_town_rights_empty_body
		}
	}

	block "location_card_town_rights_empty_extra" {}

	# ONE TOWN RIGHT SELECTED
	hbox = {
		block "location_card_town_rights_single_visible" {
			visible = "[EqualTo_int32(GetDataModelSize(Location.GetTownRights), '(int32)1')]"
		}
		datamodel = "[Location.GetTownRights]"
		item = {
			widget = {
				using = layoutpolicy_expanding
				block "location_card_town_rights_item_visible" {}

				block "location_card_town_rights_item_button" {
					button_townrights = {
						size = { 100% 100% }
						using = location_card_town_rights_item_body
					}
				}
			}
		}
	}
	block "location_town_rights_sort_highlight" {}
}
