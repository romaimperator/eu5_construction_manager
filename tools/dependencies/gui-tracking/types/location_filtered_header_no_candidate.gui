# vanilla: in_game/gui/production_lateralview.gui
# mod: in_game/gui/production_lateralview.gui

	type location_filtered_header_no_candidate = hbox {
		# !!! for performance, it's important that location_filtered_header_with_candidate and location_filtered_header_no_candidate have the same size !!!
		# Using same structure as location_filtered_header_with_candidate for placeholder visuals
		block "location_filtered_header_no_candidate_visible" {
			visible = "[And(ProductionView.IsLocationFilterEnabled, IsDataModelEmpty(BuildingItem.GetBuildingCandidates))]"
		}
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 60 }
			block "location_context"
			{
				datacontext = "[ProductionView.GetSelectedLocation]"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				using = bg_cabinet_card_frame
				margin = {2 1}

				widget = {
					size = { -1 54 }
					layoutpolicy_horizontal = expanding

					using = bg_building_card_colors
					blockoverride "building_color" {
						color = "[BuildingItem.GetBuildingType.GetPopType.GetColor]"
						alpha = 0.7
						blend_mode = overlay
					}

					icon = {
						size = {100% 100%}
						ignore_layout = yes
						visible = "[BuildingItem.GetBuildingType.GetPopType.IsClergy]"
						using = color_black_texture
						alpha = 0.2
					}

					card_header_button_04 = {
						size = { 100% 100% }
						# blockoverride "button_simple_max_size" {}

						datacontext = "[BuildingItem.GetNoCandidateUIAction]"
						using = button_action_provider


						datacontext = "[BuildingItem.GetBuildingType]"

						action_tooltip = {
							click_type = left
							click_mode = single
							click_modifier = ctrl
							title = "BUILDING_IN_LOCATION_ACTION_CTRL"
							description = "[CanBuildOrExpandBuildingInfo(BuildingItem.GetBuildingType, Location.Self)]"
							enabled = "[CanBuildOrExpandBuilding(BuildingItem.GetBuildingType, Location.Self)]"
							on_action = "[BuildOrExpandBuildingCtrl(BuildingItem.GetBuildingType, Location.Self)]"
						}
						action_tooltip = {
							click_type = left
							click_mode = single
							click_modifier = shift
							title = "BUILDING_IN_LOCATION_ACTION_SHIFT"
							description = "[CanBuildOrExpandBuildingInfo(BuildingItem.GetBuildingType, Location.Self)]"
							enabled = "[CanBuildOrExpandBuilding(BuildingItem.GetBuildingType, Location.Self)]"
							on_action = "[BuildOrExpandBuildingShift(BuildingItem.GetBuildingType, Location.Self)]"
						}

						tooltipwidget = {
							using = BuildingType_tooltip
							blockoverride "production_method_simple_good_tooltip" {
								datacontext = "[Location.GetMarket]"
								tooltipwidget = {

									using = SpecificGoodsMarket_tooltip
								}
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 6
							margin_right = 8

							# icon
							widget = {
								size = { 55 30 }

								icon = {
									size = { 29 29 }
									parentanchor = center
									texture = "[GetBuildingIcon(BuildingItem.GetBuildingType.Self)]"

									sort_by_highlight = {
										name = "name"
									}
								}
							}

							text_single = {
								autoresize = no
								size = { 140 15 }
								align = left|nobaseline
								default_format = "#yellow_titles"
								text = "[BuildingItem.GetBuildingType.GetNameWithNoTooltip]"
								datacontext = "[BuildingItem.GetBuildingType]"
							}

							expand = {}

							hbox = {
								margin_right = 3
								spacing = 6

								widget = {
									size = { 24 24 }
								}

								widget = { #efficiency
									datacontext = "[BuildingItem.GetBuildingType]"
									datacontext = "[Location]"
									size = { 70 44 } # GlorpUI: vbox stacks ROI under efficiency (1.4 widened 36->44)
									vbox = {
										# GlorpUI: stack ROI under the efficiency text
										layoutpolicy_horizontal = expanding
										hbox = { #unbuilt
											visible = "[BuildingItem.GetBuildingType.IsProducing]"
											expand = {}
											text_single = {
												size = { 70 15 } # GlorpUI: {70 18} -> {70 15}
												autoresize = no
												align = nobaseline|right
												default_format = "@bold!"
												fontsize = 13 # GlorpUI: 14->13
												text = "BUILDING_TYPE_POSSIBLE_PROD_EFFICIENCY"
												tooltipwidget = {
													SimpleContextualStringPairTooltipType = {
														blockoverride "title_icon" {
															icon = {
																using = tooltip_title_icon_size
																texture = "gfx/interface/icons/flat_icons/building_panel/production_efficiency.dds"
															}
														}
														blockoverride "concept_link" {
															text = "[production_efficiency|e]"
														}
														lowpriotextcontext = "[BuildingItem.GetBuildingType.ProductionEfficiencyInfo(Location.GetOwnerPtr, Location.Self)]"
													}
												}
											}
										}
										hbox = {
											# GlorpUI: unbuilt ROI
											expand = { }
											text_single = {
												size = { 70 15 }
												autoresize = no
												align = nobaseline|right
												fontsize = 13
												default_format = "#color_green"
												visible = "[And3(GreaterThan_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Select_CFixedPoint(Player.MakeScope.GetVariable('roiUseProfit').IsSet, GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self)), '(CFixedPoint)0'), Player.MakeScope.GetVariable('roiUseMonths').IsSet)]"
												text = "GLORP_UI_BL_BT_ROI_MONTHS_VALUE"
												tooltipwidget = {
													using = glorpUI_building_type_roi_tooltip
												}
											}
											text_single = {
												size = { 70 15 }
												autoresize = no
												align = nobaseline|right
												fontsize = 13
												default_format = "#color_green"
												visible = "[And3(GreaterThan_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Select_CFixedPoint(Player.MakeScope.GetVariable('roiUseProfit').IsSet, GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self)), '(CFixedPoint)0'), Not(Player.MakeScope.GetVariable('roiUseMonths').IsSet))]"
												text = "GLORP_UI_BL_BT_ROI_YEARS_VALUE"
												tooltipwidget = {
													using = glorpUI_building_type_roi_tooltip
												}
											}
										}
									}
								}

								widget = { #profit / income
									size = { 60 36 }
									vbox = { #built
										expand = {}
										visible = "[BuildingItem.GetBuildingType.IsProducing]"
										tooltipwidget = {
											using = BuildingTypeProfit_Tooltip
										}

										text_single = { #profit
											visible = "[Not(LessThan_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0'))]"
											size = { 60 18 }
											autoresize = no
											align = nobaseline|right
											fontsize = 14
											raw_text = "+[GetBuildingTypeProfitInLocation(BuildingItem.GetBuildingType, Location.Self)|2]@wealth!"

											sort_by_highlight = {
												size = { 105% 100% }
												name = "profit"
											}
										}
										text_single = { #profit (unprofitable)
											visible = "[LessThan_CFixedPoint(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self), '(CFixedPoint)0')]"
											size = { 60 18 }
											autoresize = no
											align = nobaseline|right
											fontsize = 14
											raw_text = "[GetBuildingTypeProfitInLocation(BuildingItem.GetBuildingType, Location.Self)|2+=]@wealth!"

											sort_by_highlight = {
												size = { 105% 100% }
												name = "profit"
											}
										}

										text_single = { #income
											size = { 60 18 }
											autoresize = no
											align = nobaseline|right
											fontsize = 14
											raw_text = "[GetBuildingTypeIncomeToOwnerInLocation(BuildingItem.GetBuildingType, Location.Self)|+=2]@income!"

											sort_by_highlight = {
												size = { 105% 100% }
												name = "income"
											}
										}
									}
								}
							}

							widget = {
								size = { 110 25 }

								hbox = {
									layoutpolicy_horizontal = expanding
									expand = {}
									widget = {
										size = { 25 25 }
										using = bg_circle_piechart

										icon = {
											visible = "[BuildingItem.GetBuildingType.BuildOnlyInCapital]"
											texture = "gfx/interface/buttons/flats/move_capital_button.dds"
											size = { 18 18 }
											parentanchor = center
											position = {-1 0}
											using = color_new_gold
										}
										icon = {
											visible = "[Not(BuildingItem.GetBuildingType.BuildOnlyInCapital)]"
											texture = "gfx/interface/icons/flat_icons/building_panel/build_button.dds"
											size = { 18 18 }
											parentanchor = center
											position = {-1 0}
											using = color_new_gold
										}
									}
								}
							}
						}
					}
					# GlorpUI: Construction Manager auto-expand button (unbuilt) - overlaid outside the card build button so it can render
					cm_auto_expand_new_building_button_pl = {
						ignore_layout = yes
						parentanchor = right|vcenter
						position = { -271 0 } # CM: centered on the 1.4 24x24 placeholder slot (was -133 for the 1.3 layout)
						datacontext = "[BuildingItem.GetBuildingType]"
					}
				}
			}
		}
	}
