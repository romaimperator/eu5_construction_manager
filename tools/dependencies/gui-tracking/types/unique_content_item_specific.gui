# vanilla: in_game/gui/multiplayer_lobby.gui
# mod: in_game/gui/cm_cmf_vanilla_type_updates.gui

	type unique_content_item_specific = widget {
		size = { 60 75 }

		block "unique_content_item_specific_bg_frame" {
			icon = {
				parentanchor = center
				size = { 100% 100% }
				texture = "gfx/interface/component_tiles/lobby/lobby_background.dds"
				texture_density = 2
				spriteType = corneredstretched
				spriteBorder = { 40 40 }
			}
		}

		# SQUARE ICONS
		widget = {
			visible = "[Or(Or(Or7(
			UniqueContentItem.IsAdvanceDefinition,
			UniqueContentItem.IsLaw,
			UniqueContentItem.IsBuildingType,
			UniqueContentItem.IsCountryInteraction,
			UniqueContentItem.IsCabinetAction,
			UniqueContentItem.IsDisasterType,
			UniqueContentItem.IsSituation),
			Or7(
			UniqueContentItem.IsBureaucracyType,
			UniqueContentItem.IsCharacterInteraction,
			UniqueContentItem.IsFormableCountry,
			UniqueContentItem.IsGenericAction,
			UniqueContentItem.IsHeirSelection,
			UniqueContentItem.IsPolicy,
			UniqueContentItem.IsSocietalValueType)),
			Or7(
			UniqueContentItem.IsSubjectType,
			UniqueContentItem.IsTownRightsType,
			UniqueContentItem.IsReligiousAspect,
			UniqueContentItem.IsOmen,
			UniqueContentItem.IsDecision,
			UniqueContentItem.IsReligiousOrderType,
			UniqueContentItem.IsCalling))]"

			block "unique_content_item_specific_bg" {}

			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)1.0', '(float)1.0')]"
			position = { 0 9% }

			widget = {
				ignore_layout = yes
				size = { 64 64 }
				parentanchor = center
				background = {
					using = bg_flat_bg_button_texture
					margin = {-4 -4}
					modify_texture = {using = color_dark_brown_texture}
					alpha = 0.7
				}
				background = {
					texture = "gfx/interface/component_tiles/lobby/country_lobby_flavor_frame_round.dds"
					texture_density = 2
				}
			}

			# ADVANCE
			icon = {
				visible = "[UniqueContentItem.IsAdvanceDefinition]"
				datacontext = "[UniqueContentItem.GetAdvanceDefinition]"
				block "country_culture_datacontext" {}

				parentanchor = center
				size = { 70% 70% }

				widget = {
					parentanchor = center
					size = { 100% 100% }
					visible = "[Not(AdvanceDefinition.HasSubunitUnlocks)]"
					datacontext = "[GetPlayer]"
					using = advance_icon_base
				}

				# Unit illustrations need a smaller scale than flat icons to avoid bleeding past the card frame
				widget = {
					parentanchor = center
					size = { 85% 85% }
					visible = "[AdvanceDefinition.HasSubunitUnlocks]"
					datacontext = "[GetPlayer]"
					using = advance_icon_base
				}
			}

			# LAW
			icon = {
				visible = "[UniqueContentItem.IsLaw]"
				parentanchor = center
				size = { 62% 62% }
				texture = "[GetLawIcon(UniqueContentItem.GetLaw)]"
			}

			# BUILDING
			icon = {
				visible = "[UniqueContentItem.IsBuildingType]"
				parentanchor = center
				size = { 50% 50% }
				texture = "[GetBuildingIcon(UniqueContentItem.GetBuildingType)]"
			}

			# COUNTRY INTERACTIONS
			icon = {
				visible = "[UniqueContentItem.IsCountryInteraction]"
				parentanchor = center
				size = { 62% 62% }
				texture = "gfx/interface/icons/flat_icons/tabicons/diplomacy.dds"
			}

			# DECISION
			icon = {
				visible = "[UniqueContentItem.IsDecision]"
				parentanchor = center
				size = { 62% 62% }
				texture = "[GetConceptTexture('decision')]"
			}

			# CABINET ACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCabinetAction]"

				cabinet_action_power = {
					datacontext = "[UniqueContentItem.GetCabinetAction]"
					parentanchor = center
					size = { 66% 66% }
					texture = "[GetCabinetActionIcon(CabinetAction.Self)]"
				}
			}

			# DISASTER
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsDisasterType]"

				icon = {
					datacontext = "[UniqueContentItem.GetDisasterType]"
					parentanchor = center
					size = { 100% 100% }
					texture = "[DisasterType.GetIcon]"
				}
			}

			# SITUATION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSituation]"

				icon = {
					datacontext = "[UniqueContentItem.GetSituation]"
					parentanchor = center
					size = { 75% 75% }
					texture = "[Situation.GetIcon]"
				}
			}

			# BUREAUCRACY TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsBureaucracyType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetBureaucracyType]"
					texture = "[GetBureaucracyIcon(BureaucracyType.Self)]"
				}
			}

			# CHARACTER INTERACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCharacterInteraction]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetCharacterInteraction]"
					texture = "[CharacterInteraction.GetIcon]"
				}
			}

			# FORMABLE COUNTRY
			widget = {
				parentanchor = center
				size = { 80% 80% }
				visible = "[UniqueContentItem.IsFormableCountry]"

				country_flag = {
					datacontext = "[UniqueContentItem.GetFormableCountry]"
					size = { 100% 66% }
					parentanchor = center

					blockoverride "tooltip" {
						tooltip_enabled = no
						tagtooltip_enabled = no
					}

					blockoverride "contextmenu" {
						contextmenu_enabled = no
					}

					blockoverride "flag" {
						datacontext = "[FormableCountry.GetOrCreateCoatOfArms(Player.Self)]"
						texture = "[CoatOfArmsWrapper.GetTexture('(int32)144','(int32)96')]"
						frame = "[CoatOfArmsWrapper.GetFrame('(int32)144','(int32)96')]"
						framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)144','(int32)96','(float)0.5')]"
						texture_density = 2
					}

					blockoverride "click" {}
					blockoverride "double_click" {}
					blockoverride "hover" {}
				}
			}

			# GENERIC ACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsGenericAction]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetGenericAction]"
					texture = "[GenericAction.GetIcon]"
				}
			}

			# HEIR SELECTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsHeirSelection]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					texture = "[GetConceptTexture('heir_selection')]"
				}
			}

			# POLICY
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsPolicy]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetPolicy]"
					texture = "[GetLawIcon(Policy.GetLaw)]"
				}
			}

			# SOCIETAL VALUE TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSocietalValueType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					texture = "[GetConceptTexture('societal_value')]"
				}
			}

			# SUBJECT TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSubjectType]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					texture = "[GetConceptTexture('subject_type')]"
				}
			}

			# TOWN RIGHTS TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsTownRightsType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetTownRightsType]"
					texture = "[TownRightsType.GetIcon]"
				}
			}

			# RELIGIOUS ASPECT
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsReligiousAspect]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetReligiousAspect]"
					texture = "[GetReligiousAspectIcon(ReligiousAspect.Self)]"
				}
			}

			# OMEN
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsOmen]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetOmen]"
					texture = "[GetOmenIcon(Omen.Self)]"
				}
			}

			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsReligiousOrderType]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					datacontext = "[UniqueContentItem.GetReligiousOrderType]"
					texture = "[ReligiousOrderType.GetIcon]"
				}
			}

			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCalling]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					datacontext = "[UniqueContentItem.GetCalling]"
					texture = "[Calling.GetIcon]"
				}
			}
		}

		# SUBUNIT DEFINITION
		widget = {
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.8181', '(float)0.80')]"
			parentanchor = center
			visible = "[UniqueContentItem.IsSubUnitDef]"
			widget = {
				size = { 48 60 }
				parentanchor = center
				datacontext = "[UniqueContentItem.GetSubUnitDef]"
				block "country_culture_datacontext" {}
				block "subunit_illustration" {
					using = unit_type_illustration_playable
				}

				widget = {
					ignore_layout = yes
					size = { 60 64 }
					parentanchor = center
					background = {
						using = bg_country_lobby_flavor_frame_texture
					}
				}
			}
		}

		# LEVY SETUP
		widget = {
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.8181', '(float)0.80')]"
			parentanchor = center
			visible = "[UniqueContentItem.IsLevySetup]"
			widget = {
				size = { 48 60 }
				parentanchor = center
				datacontext = "[UniqueContentItem.GetLevySetup.GetUnit]"
				block "country_culture_datacontext" {}
				block "subunit_illustration" {
					using = unit_type_illustration_playable
				}

				widget = {
					ignore_layout = yes
					size = { 60 64 }
					parentanchor = center
					background = {
						using = bg_country_lobby_flavor_frame_texture
					}
				}
			}
		}


		# GOV REFORM
		widget = {
			visible = "[UniqueContentItem.IsGovernmentReform]"
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.7143', '(float)0.72')]"
			parentanchor = center

			estate_reform_action_button_alt = {
				datacontext = "[UniqueContentItem.GetGovernmentReform]"
				size = { 44 60 }
				parentanchor = center
				blockoverride "estate_reform_button_visible" {
					visible = no
				}
				blockoverride "estate_reform_icon_visible" {
					visible = yes
				}
				blockoverride "icon_texture" {
					texture = "[GetGovernmentReformIllustration(GovernmentReform.Self)]"
				}
				blockoverride "reform_item_normal_visibility" {
					visible = "[And(Not(GovernmentReform.IsUnique),Not(GovernmentReform.IsMajor))]"
				}
				blockoverride "reform_item_unique_visibility" {
					visible = "[GovernmentReform.IsUnique]"
				}
				blockoverride "reform_item_major_visibility" {
					visible = "[And(Not(GovernmentReform.IsUnique),GovernmentReform.IsMajor)]"
				}
			}
		}


		# ESTATE PRIVILEGE
		widget = {
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.7143', '(float)0.72')]"
			parentanchor = center
			visible = "[UniqueContentItem.IsEstatePrivilege]"

			widget = {
				datacontext = "[UniqueContentItem.GetEstatePrivilege]"
				size = { 100% 100% }

				icon = {
					parentanchor = center
					size = { 90% 90% }
					texture = "[GetEstatePrivilegeIcon(EstatePrivilege.Self)]"
				}

				icon = {
					size = { 100% 100% }

					background = {
						using = bg_frame_shadow_ep_texture
						using = color_dark_brown
					}

					background = {
						texture = "gfx/interface/buttons/estate_privileges/frame_2_ep.dds"
						using = color_dark_brown
						texture_density = 2
					}

					texture = "gfx/interface/buttons/estate_privileges/frame_1_ep.dds"
					texture_density = 2

					modify_texture = {
						using = color_new_gold_texture
						blend_mode = add
					}
				}
			}
		}
	}
