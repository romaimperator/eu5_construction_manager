															parentanchor = center
															autoresize = no
															visible = "[BuildingCandidate.GetBuilding.IsUnderConstruction]"
															raw_text = "[BuildingCandidate.GetBuilding.GetLevel|0Y] ([BuildingCandidate.GetBuilding.GetLevelsUnderConstruction|0+=]) / [BuildingCandidate.GetMaxLevel|0Y]"
															align = center
															default_format = "#overview_text"
	
															tooltipwidget = {
																using = BuildingMaxLevel_Tooltip
															}
	
															sort_by_highlight = {
																name = "level"
															}
														}
													}													
	
													building_expansion_risk_badge = {														
														datacontext = "[BuildingCandidate.GetBuilding.GetType]"
														datacontext = "[BuildingCandidate.GetBuilding.GetLocation]"
														blockoverride "building_expansion_risk_badge_visible" {
															visible = "[And(BuildingCandidate.GetBuilding.GetType.IsProducing, CanExpandBuilding(BuildingCandidate.GetBuilding))]"
														}
														blockoverride "building_expansion_risk_badge_no_risk_label" {
															text = "BUILDING_CONSTRUCTION_RISK_LABEL_NONE_BUILDING_CANDIDATE"
														}
