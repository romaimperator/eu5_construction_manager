										# }

										header_button_left = {
											onmousehierarchyenter = "[PdxGuiWidget.SetHighlightUnitAbility(UnitActionItem.Self)]"
											visible = "[Not(UnitActionItem.IsToggleAction)]"
											parentanchor = bottom|left
											size = { 34 34 }
											blockoverride "button_icon_stretch_sprite" {}
											blockoverride "header_button_frame_inner" {visible = no}
											# blockoverride "header_button_icon_size" { size = { 100% 100% } }
											blockoverride "header_button_text_layout" {}
											blockoverride "icon_overlay" {}
											blockoverride "icon_texture" {
												size = { 100% 100% }
												texture = "[UnitActionItem.GetTexture]"
												position = { -2 -2 }
											}
											action_tooltip = {
												click_type = left
												click_mode = confirm
												title = "[UnitActionItem.GetName]"
												visible = "[UnitActionItem.HasHoldLeftAction]"
												on_action = "[UnitActionItem.HoldLeftClick]"
												enabled = "[UnitActionItem.CanHoldLeftClick]"
												description = "[UnitActionItem.GetLeftClickDescription]"
											}

											action_tooltip = {
												click_type = right
												click_mode = confirm

												visible = "[UnitActionItem.HasHoldRightAction]"
												title = "[UnitActionItem.GetSecondaryName]"
												on_action = "[UnitActionItem.HoldRightClick]"
												enabled = "[UnitActionItem.CanHoldRightClick]"
												description = "[UnitActionItem.GetRightClickDescription]"
											}

											action_tooltip = {
												visible = "[UnitActionItem.HasSingleLeftAction]"
												title = "[UnitActionItem.GetName]"
												on_action = "[UnitActionItem.SingleLeftClick]"
												conditions = "[MakeItFailIf(Not(UnitActionItem.CanSingleLeftClick), UnitActionItem.GetTooltip)]"
												enabled = "[UnitActionItem.CanSingleLeftClick]"
												description = "[UnitActionItem.GetLeftClickDescription]"
											}

											action_tooltip = {
												visible = "[UnitActionItem.HasShiftLeftClick]"
												title = "[UnitActionItem.GetShiftLeftName]"
												click_mode = single
												click_type = left
												click_modifier = shift
												on_action = "[UnitActionItem.SingleLeftClick]"
												conditions = "[MakeItFailIf(Not(UnitActionItem.CanSingleLeftClick), UnitActionItem.GetTooltip)]"
												enabled = "[UnitActionItem.CanSingleLeftClick]"
												description = "[UnitActionItem.GetLeftClickDescription]"
											}

											enabled = "[UnitActionItem.IsEnabled]"

											input_action = "[UnitActionItem.GetShortcut]"
											datacontext = "[UnitActionItem]"
											tooltipwidget = {
												using = UnitAction_tooltip
											}
										}

										UnitAbilitCheckbox = {
											visible = "[UnitActionItem.IsToggleAction]"
											parentanchor = bottom|left
											size = { 34 34 }

											blockoverride "icon_replace" {
												using = toggle_unit_action_icon
											}
											blockoverride "header_button_left_extra_texture" {
												background = {
													texture = "gfx/interface/component_tiles/square_glow.dds"
													margin = {5 5}
													visible = "[UnitActionItem.IsActive]"
													modify_texture = {
														using = color_bone_texture
													}
													modify_texture = {
														using = color_white_texture
														blend_mode = overlay
														alpha = 0.2
													}
												}
												background = {
													texture = "gfx/interface/component_tiles/square_glow.dds"
													margin = {9 9}
													visible = "[UnitActionItem.IsSecondaryActive]"
													modify_texture = {
														using = color_new_gold_texture
													}
												}
											}
											blockoverride "header_button_modify_visible" {
												visible = "[UnitActionItem.IsActive]"
											}

											action_tooltip = {
												click_type = right
												click_mode = single
												visible = "[UnitActionItem.HasSingleRightAction]"
												title = "[UnitActionItem.GetSecondaryName]"
												on_action = "[UnitActionItem.SingleRightClick]"
												enabled = "[UnitActionItem.CanSingleRightClick]"
												description = "[UnitActionItem.GetRightClickDescription]"
											}

											widget = {
												visible = "[UnitActionItem.HasSingleRightAction]"
												parentanchor = top|left
												size = { 16 16 }
												alwaystransparent = yes

												background = {
													texture = "gfx/interface/buttons/checkbox_auto_bg.dds"
													texture_density = 2
													using = color_dark_blue
													margin = { 1 1 }
													shaderfile = "gfx/FX/pdxgui_default.shader"
												}

												icon = {
													visible = "[Not(UnitActionItem.IsSecondaryActive)]"
													size = { 100% 100% }
													using = checkbox_auto_texture
													frame = 1
												}

												icon = {
													visible = "[UnitActionItem.IsSecondaryActive]"
													size = { 100% 100% }
													using = checkbox_auto_texture
													frame = 2
												}
											}


											enabled = "[UnitActionItem.CanSingleLeftClick]"
											input_action = "[UnitActionItem.GetShortcut]"
											down = "[UnitActionItem.IsActive]"

											datacontext = "[UnitActionItem]"
											action_tooltip = {
												visible = "[UnitActionItem.HasSingleLeftAction]"
												title = "[UnitActionItem.GetName]"
												on_action = "[UnitActionItem.SingleLeftClick]"
												conditions = "[UnitActionItem.GetTooltip]"
												enabled = "[UnitActionItem.CanSingleLeftClick]"
												description = "[UnitActionItem.GetLeftClickDescription]"
											}
											tooltipwidget = {
												using = UnitAction_tooltip
											}
										}
									}
								}

								button_pin = {
									size = { 18 18 }
									parentanchor = right|top
									alpha = 0

									state = {
										name = show_pin
										position_y = -3
										duration = 0.25
										alpha = 1
										using = Animation_Curve_Default
										next = show_pin_2
									}
									state = {
										name = show_pin_2
										position_y = 0
										duration = 0.12
										using = Animation_Curve_Default
									}
									state = {
										name = hide_pin
										position_y = -3
										duration = 0.25
										alpha = 0
										using = Animation_Curve_Default
									}

									name = "button_pin"

									action_tooltip = {
										title = "[SelectLocalization(PinCollection.IsPinnedWithDefaultValue( UnitActionItem.GetKey, UnitActionItem.IsPinnedByDefault ), 'UNPIN_ACTION', 'PIN_ACTION')]"
										on_action = "[PinCollection.Toggle( UnitActionItem.GetKey )]"
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }
									down = "[PinCollection.IsPinnedWithDefaultValue( UnitActionItem.GetKey, UnitActionItem.IsPinnedByDefault )]"
								}
							}
						}
					}
				}
			}
		}
	}
}

# Battle view (vanilla: in_game/gui/battle_lateralview.gui)
types BattleTypes {
	type combat_country_ruler = vbox {
		layoutpolicy_vertical = expanding
		spacing = 3
		hbox = {
			layoutpolicy_horizontal = expanding
			block "combat_country_ruler_flag" {
				# FLAG
				widget = {
					size = { 115 76 }
					datacontext = "[CombatSide.GetCountry]"

					country_flag_mid = {
						size = { 100% 100% }
					}
				}
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = -6
			block "combat_ruler_rightleft" {
				righttoleft = yes
			}

			widget = {
				size = { 43 81 }

				vbox = {
					margin = {3 0}
					spacing = 8
					visible = "[And(CombatSide.GetCommander.IsValid, CombatSide.GetCommander.ShowsStats)]"
					datacontext = "[CombatSide.GetCommander]"
					tagtooltip_enabled = yes
					tooltip = "[Character.GetAbilityTooltipAsGeneral]"
					expand = {}
					hbox = {

						layoutpolicy_horizontal = expanding
						widget = {
							size = { 17 17 }
							using = icon_adm_alt
						}

						text_single = {
							visible = "[CombatSide.GetCommander.CanGiveUnitBonus]"
							layoutpolicy_horizontal = expanding
							size = { -1 17 }
							autoresize = no
							using = abilities_text_props
							text = "[Character.GetAbility('adm')]"
							fontsize = 12
						}

						text_single = {
							visible = "[Not(CombatSide.GetCommander.CanGiveUnitBonus)]"
							layoutpolicy_horizontal = expanding
							size = { 20 17 }
							text = "[Character.GetAbility('adm')]"

							fontsize = 12

							layoutpolicy_vertical = expanding
							autoresize = no
							align = center|nobaseline
							using = Font_Size_Small
							default_format = "#S"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						widget = {
							size = { 17 17 }
							using = icon_dip_alt
						}

						text_single = {
							visible = "[CombatSide.GetCommander.CanGiveUnitBonus]"
							layoutpolicy_horizontal = expanding
							size = { -1 17 }
							autoresize = no
							using = abilities_text_props
							text = "[Character.GetAbility('dip')]"
							fontsize = 12
						}

						text_single = {
							visible = "[Not(CombatSide.GetCommander.CanGiveUnitBonus)]"
							layoutpolicy_horizontal = expanding
							size = { 20 17 }
							text = "[Character.GetAbility('dip')]"

							fontsize = 12

							layoutpolicy_vertical = expanding
							autoresize = no
							align = center|nobaseline
							using = Font_Size_Small
							default_format = "#S"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						widget = {
							size = { 17 17 }
							using = icon_mil_alt
						}

						text_single = {
							visible = "[CombatSide.GetCommander.CanGiveUnitBonus]"
							layoutpolicy_horizontal = expanding
							size = { -1 17 }
							autoresize = no
							using = abilities_text_props
							text = "[Character.GetAbility('mil')]"
							fontsize = 12
						}

						text_single = {
							visible = "[Not(CombatSide.GetCommander.CanGiveUnitBonus)]"
							layoutpolicy_horizontal = expanding
							size = { 20 17 }
							text = "[Character.GetAbility('mil')]"

							fontsize = 12

							layoutpolicy_vertical = expanding
							autoresize = no
							align = center|nobaseline
							using = Font_Size_Small
							default_format = "#S"
						}
					}

					expand = {}
				}
			}

			# CHARACTER
			character_frame_medium = {
				enabled = "[CombatSide.GetCommander.CanGiveUnitBonus]"
				visible = "[CombatSide.GetCommander.IsValid]"
				datacontext = "[CombatSide.GetCommander]"
				blockoverride "character_frame_texture_color" {
					enabled = "[CombatSide.GetCommander.CanGiveUnitBonus]"
				}
				blockoverride "character_frame_size" {
					size = { 65 81 }
				}
				blockoverride "portrait_position" {position = { -5 1 }}
				blockoverride "portrait_size" { size = { 85% 90% } }
				blockoverride "character_frame_texture" {
					texture = "gfx/interface/component_decoration/character_frames/character_non_stretchable_frame_2.dds"
				}
				blockoverride "character_portrait_visible" {
					visible = no
				}

				blockoverride "character_portrait_ani_visible" {
					visible = yes
				}
				blockoverride "character_portrait_ani_size" {
					size = { 120% 120% }
				}
				blockoverride "character_ribbon" {
					character_ribbon_1 = {
						visible = "[Character.HasRebel]"
						blockoverride "stretchable" {}
						blockoverride "ribbon color" {
							modify_texture = {
								using = color_black_texture
								blend_mode = overlay
							}
						}
					}
					character_ribbon_3 = {
						visible = "[And(Character.IsCivilWarRuler, Not(Character.HasRebel))]"
						blockoverride "stretchable" {}
						blockoverride "ribbon color" {
							modify_texture = {
								using = color_black_texture
								blend_mode = overlay
							}
						}
					}
					character_ribbon_3 = {
						visible = "[And3(Character.IsRuler, Not(Character.HasRebel), Not(Character.IsCivilWarRuler))]"
						blockoverride "stretchable" {}
					}
				}
			}

			character_frame_medium = {
				visible = "[Not(CombatSide.GetCommander.IsValid)]"
				datacontext = "[CombatSide.GetCommander]"
				blockoverride "character_frame_size" {
					size = { 65 81 }
				}
				blockoverride "portrait_position" {position = { 0 1 }}
				blockoverride "portrait_size" { size = { 85% 90% } }
				blockoverride "character_frame_texture" {
					texture = "gfx/interface/component_decoration/character_frames/character_non_stretchable_frame_2.dds"
				}
				blockoverride "character_portrait_visible" {
					visible = no
				}

				blockoverride "character_portrait_ani_visible" {
					visible = yes
				}
				blockoverride "character_ribbon" {
					character_ribbon_1 = {
						visible = "[Character.HasRebel]"
						blockoverride "stretchable" {}
						blockoverride "ribbon color" {
							modify_texture = {
								using = color_black_texture
								blend_mode = overlay
							}
						}
					}
					character_ribbon_3 = {
						visible = "[And(Character.IsCivilWarRuler, Not(Character.HasRebel))]"
						blockoverride "stretchable" {}
						blockoverride "ribbon color" {
							modify_texture = {
								using = color_black_texture
								blend_mode = overlay
							}
						}
					}
					character_ribbon_3 = {
						visible = "[And3(Character.IsRuler, Not(Character.HasRebel), Not(Character.IsCivilWarRuler))]"
						blockoverride "stretchable" {}
					}
				}
			}
		}

		expand = {}
	}
}

# Multiplayer lobby (CMF replaces this file) (vanilla: in_game/gui/multiplayer_lobby.gui)
types MultiplayerLobby {
	# CM: keeps CMF's lowpriotextcontext tooltip fix, merged with 1.4.4's size changes
	type LobbyCountryListWidget = widget {
		size = { 430 -1 }
		layoutpolicy_vertical = expanding
		using = bg_main_inner_notabs_alt
		alwaystransparent = no
		filter_mouse = all

		state = {
			name = "jomini_preselected_changed"
			# Can be used for showing a fancy animation when changing country selection in the lobby
			duration = 0
			alpha = 1
		}

		vbox = {
			using = layoutpolicy_expanding
			margin_bottom = 25

			window_header_alt = {
				using = bg_main_inner_alt
				blockoverride "window_header_alt_color_texture"{
					using = color_default_brown_texture
				}

				blockoverride "header_text" {
					text = "SELECT_TITLE_FRONTEND"
				}
			}

			vbox = {
				using = layoutpolicy_expanding
				margin = {15 0}

				widget = {
					name = "lobby_country_list"
					using = layoutpolicy_expanding

					filtered_sorted_list = {
						datacontext = "[AccessLobbyCountryList.GetCountriesSortSearch.WithFilterTags('no_filters')]"

						blockoverride "sort_buttons_filtered_list" {
							sort_by_key_button = {
								name = "name"
								using = layoutpolicy_expanding
							}

							sort_by_key_button = {
								name = "difficulty"
								using = layoutpolicy_expanding
							}

							sort_by_key_button = {
								name = "country_type"
								using = layoutpolicy_expanding
							}

							sort_by_key_button = {
								name = "population"
								using = layoutpolicy_expanding
							}

							sort_by_key_button = {
								name = "unique_content"
								using = layoutpolicy_expanding
							}
						}

						blockoverride "scroll_list_layout" {
							fixedgridbox = {
								datamodel = "[AccessLobbyCountryList.GetCountries]"
								addcolumn = 100%
								addrow = 74
								datamodel_wrap = 1
								flipdirection = yes
								setitemsizefromcell = yes

								item = {
									widget = {
										size = { 100% 90% }
										tooltipwidget = {
											using = CountryTooltip
										}

										vbox = {
											clickable_header_card = {
												onmousehierarchyenter = "[PdxGuiWidget.SetHighlightCountry( Country.Self )]"
												blockoverride "header_color" {
													texture = "gfx/interface/colors/mid_blue.dds"
												}
												blockoverride "header_pattern" {
													texture = "gfx/interface/cards/headers/header_pattern_07.dds"
													alpha = 0.7
												}
												blockoverride "clickable_header_card_size"{
													size = { -1 65 }
												}
												blockoverride "header_size" {
													size = { -1 35 }
												}
												blockoverride "header_content" {
													ondoubleclick = "[PanToCountry(Country.Self)]"

													action_tooltip = {
														click_type = left
														click_mode = single

														block "click_action" {
															title = "LOBBYVIEW_SELECT_COUNTRY"
															on_action = "[SetLobbyCountry(Country.Self)]"
														}
													}

													background = {
														using = color_mid_blue_texture
														margin = {0 0}
														alpha = 0.8

														modify_texture = {
															using = bg_mask_fade_horizontal_texture
															blend_mode = alphamultiply
															mirror = horizontal
														}
													}

													widget = {
														size = {100% 100%}
														hbox = {
															margin_left = 90
															margin_right = 5
															text_single = {
																using = layoutpolicy_expanding
																autoresize = no
																align = left|nobaseline
																using = Font_Type_Headers
																using = Font_Size_Small
																alwaystransparent = yes
																text = "[Country.GetLongNameWithNoTooltip]"

																block "name_sort_highlight" {}
															}

															hbox = {
																spacing = 0
																ignoreinvisible = yes

																# gov type
																widget = {
																	size = { 23 23 }
																	icon = {
																		size = { 20 20 }
																		position = {0 -1}
																		parentanchor = center
																		texture = "[GetGovernmentTypeIcon(Country.GetGovernment.GetGovernmentType)]"
																		texture_density = 2

																		datacontext = "[Country.GetGovernment.GetGovernmentType]"
																		tooltipwidget = {
																			using = GovernmentType_tooltip

																			blockoverride "title_icon_texture" {
																				texture = "[GetGovernmentTypeIcon(Country.GetGovernment.GetGovernmentType)]"
																			}
																		}
																	}
																}

																# country type
																widget = {
																	size = { 23 23 }

																	icon = {
																		size = { 20 20 }
																		position = {0 1}
																		parentanchor = center
																		texture = "[GetCountryTypeIcon(Country.Self)]"
																		texture_density = 2

																		tooltipwidget = {
																			using = CountryType_tooltip
																		}

																		glow = {
																			name = "drop_shadow"
																			glow_radius = 3
																			color = {0.0 0.0 0.0 1.0}
																			alpha = 0.5
																		}

																		block "country_type_sort_highlight" {}
																	}
																}

																# country rank
																widget = {
																	size = { 23 23 }

																	icon = {
																		size = { 20 20 }
																		parentanchor = left|vcenter
																		texture = "[GetCountryRankIcon(Country.GetRank)]"
																		texture_density = 2
																		alpha = 1

																		datacontext = "[Country.GetRank]"
																		tooltipwidget = {
																			using = CountryRank_tooltip
																		}

																		glow = {
																			name = "drop_shadow"
																			glow_radius = 3
																			color = {0.0 0.0 0.0 1.0}
																			alpha = 0.6
																		}
																	}
																}
															}
														}
													}
												}
												blockoverride "bottom_content" {

													widget = {
														size = {100% 100%}
														hbox = {
															margin_left = 90
															spacing = 2

															# DIFFICULTY
															text_single = {
																using = layoutpolicy_expanding
																autoresize = no
																align = center|nobaseline
																visible = "[Country.HasDifficultyLevel]"
																text = "[Country.GetDifficultyLevelName]"
																tooltipwidget = {
																	SimpleContextualTooltipType = {
																		blockoverride "title_icon" {
																			icon = {
																				using = tooltip_title_icon_size
																				texture = "gfx/interface/icons/alerts_icons/welcome_to_caesar.dds"
																			}
																		}
																		blockoverride "concept_link" {
																			text = "[country|E]"
																		}
																		# CMF: avoids a tooltip error
																		lowpriotextcontext = "[Country.GetDifficultyLevelDesc]"
																	}
																}

																block "difficulty_sort_highlight" {}
															}

															divider_flavor_01 = {
																visible = "[And(Country.HasCountryDescriptionCategory,Country.HasDifficultyLevel)]"
																size = {9 -1}
															}

															# ARCHETYPES
															text_single = {
																visible = "[Country.HasCountryDescriptionCategory]"
																using = layoutpolicy_expanding
																autoresize = no
																align = center|nobaseline
																text = "[Country.GetCountryDescriptionCategoryName]"

																tooltipwidget = {
																	ContextualTooltipType = {
																		blockoverride "title_icon" {

																			country_flag_mid = {
																				size = { 53 35 }
																			}
																		}

																		blockoverride "title_text" {
																			text = "[Country.GetCountryDescriptionCategoryName]"
																		}

																		blockoverride "concept_link" {
																			text = "[country|e]"
																		}

																		blockoverride "tooltip_content" {
																			TooltipTextBlock = {
																				textcontext = "[Country.GetCountryDescriptionCategoryDesc]"																			}
																		}
																	}
																}
															}

															divider_flavor_01 = {
																visible = "[Country.HasCountryDescriptionCategory]"
																size = {9 -1}
															}

															# POPULATION
															text_single = {
																using = layoutpolicy_expanding
																autoresize = no
																align = center|nobaseline
																text = "[Country.GetTotalPopulation]"

																block "population_sort_highlight" {}
															}

															expand = {}
														}
													}
												}
											}
										}
										country_flag_mid = {
											size = { 82 55 }
											parentanchor = left|vcenter
											position = {0 0}

											blockoverride "hover_leave" {}
										}
									}
								}
							}
						}
					}
				}
			}

			expand = {}
		}

		widget = {
			parentanchor = right
			size = { 40 40 }

			ui_direction_button_holder_right = {}

			button_close_alt = {
				blockoverride "close_on_action" {
					on_action = "[GameLobby.Vars.SetOrToggle('tab','country_list')]"
				}
				blockoverride "close_inputaction" {}
			}
		}

		window_bottom_paper_template = {}
	}

	type LobbyViewPlayerList = widget {
		using = layoutpolicy_expanding
		alwaystransparent = no
		visible = "[GameIsMultiplayer]"
		onmousehierarchyenter = "[PdxGuiWidget.PushMapModeOverride('players')]"
		onmousehierarchyleave = "[PdxGuiWidget.PopMapModeOverride]"

		vbox = {
			LobbySubHeader = {
				blockoverride "text" {
					text = "JOMINI_MULTIPLAYER_GUI_PLAYER_LIST_LABEL"
				}
			}

			scrollbox = {
				using = layoutpolicy_expanding

				blockoverride "scrollbox_content" {
					margin_top = 10
					fixedgridbox = {
						addcolumn = 400
						addrow = 52
						setitemsizefromcell = yes

						datamodel = "[LobbyView.Players]"
						item = {
							widget = {
								JominiLobbyViewPlayerItem = {
									size = { 97% 50 }
									parentanchor = left|vcenter
								}
							}
						}
					}
				}

				blockoverride "scrollbox_empty" {
					visible = "[IsDataModelEmpty( LobbyView.Players )]"
					text = ""
				}

				blockoverride "scrollbox_expand" {
					expand = {
						layoutpolicy_vertical = growing
						visible = "[DataModelHasItems( LobbyView.Players )]"
					}
				}
			}
		}
	}

	type dlc_banner = button {
		texture_density = 3
		texture = "gfx/interface/alerts/dlc_alert_background.dds"

		button = {
			alwaystransparent = yes
			tooltip_enabled = no
			parentanchor = center
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)1.0', '(float)0.75')]"
			texture = "[GameDLC.GetIcon]"
			glow = {
				name = "drop_shadow"
				glow_radius = 5
				color = {0.0 0.0 0.0 1.0}
				alpha = 0.2
			}
		}

		onmousehierarchyenter = "[PdxGuiWidget.PushDLCMapModeOverride(GameDLC.Self)]"
		onmousehierarchyleave = "[PdxGuiWidget.ClearDLCMapModeOverride]"

		action_tooltip = {
			title = "GAME_DLC_SHOW_VIEW_CLICK"
			on_action = "[ShowDLCView(GameDLC.Self)]"
		}

		tooltipwidget = {
			ExtraContentTooltipType = {
				# blockoverride "title_header_color" { tintcolor = "[GetColorDLC(DlcEntry.Filename)]"}
				blockoverride "title_text" { text = "[GameDLC.GetName]" }
				blockoverride "owned_text" { text = "GAME_DLC_TOOLTIP_OWNED" }
				blockoverride "installed_text" { text = "GAME_DLC_TOOLTIP_INSTALLED" }
				blockoverride "mounted_text" { text = "GAME_DLC_TOOLTIP_MOUNTED" }
				blockoverride "activated_text" { text = "GAME_DLC_TOOLTIP_ACTIVATED" }
				blockoverride "ExtraContentTooltipType_background_texture" { texture = "[GameDLC.GetTooltipBackground]" }

				blockoverride "flavor_text" {
					text = "[GameDLC.GetTooltipDesc]"
				}
			}
		}
	}

	type short_dlc_banner = button {
		texture = "gfx/interface/alerts/dlc_alert_background_purple_short.dds"
		texture_density = 4

		onmousehierarchyenter = "[PdxGuiWidget.PushDLCMapModeOverride(GameDLC.Self)]"
		onmousehierarchyleave = "[PdxGuiWidget.ClearDLCMapModeOverride]"

		action_tooltip = {
			title = "GAME_DLC_SHOW_VIEW_CLICK"
			on_action = "[ShowDLCView(GameDLC.Self)]"
		}

		icon = {
			parentanchor = center
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)1.0', '(float)0.75')]"
			position = { 0 -4 }
			texture = "[GameDLC.GetIcon]"
		}

		tooltipwidget = {
			ExtraContentTooltipType = {
				# blockoverride "title_header_color" { tintcolor = "[GetColorDLC(DlcEntry.Filename)]"}
				blockoverride "title_text" { text = "[GameDLC.GetName]" }
				blockoverride "owned_text" { text = "GAME_DLC_TOOLTIP_OWNED" }
				blockoverride "installed_text" { text = "GAME_DLC_TOOLTIP_INSTALLED" }
				blockoverride "mounted_text" { text = "GAME_DLC_TOOLTIP_MOUNTED" }
				blockoverride "activated_text" { text = "GAME_DLC_TOOLTIP_ACTIVATED" }
				blockoverride "ExtraContentTooltipType_background_texture" { texture = "[GameDLC.GetTooltipBackground]" }

				blockoverride "flavor_text" {
					text = "[GameDLC.GetTooltipDesc]"
				}
			}
		}
	}

	type unique_content_item_specific = widget {
		size = { 60 75 }

		block "unique_content_item_specific_bg_frame" {
			icon = {
				parentanchor = center
				size = { 100% 100% }
				texture = "gfx/interface/component_tiles/lobby/lobby_background.dds"
				texture_density = 2
				spriteType = corneredstretched
				spriteBorder = { 40 40 }
			}
		}

		# SQUARE ICONS
		widget = {
			visible = "[Or(Or(Or7(
			UniqueContentItem.IsAdvanceDefinition,
			UniqueContentItem.IsLaw,
			UniqueContentItem.IsBuildingType,
			UniqueContentItem.IsCountryInteraction,
			UniqueContentItem.IsCabinetAction,
			UniqueContentItem.IsDisasterType,
			UniqueContentItem.IsSituation),
			Or7(
			UniqueContentItem.IsBureaucracyType,
			UniqueContentItem.IsCharacterInteraction,
			UniqueContentItem.IsFormableCountry,
			UniqueContentItem.IsGenericAction,
			UniqueContentItem.IsHeirSelection,
			UniqueContentItem.IsPolicy,
			UniqueContentItem.IsSocietalValueType)),
			Or7(
			UniqueContentItem.IsSubjectType,
			UniqueContentItem.IsTownRightsType,
			UniqueContentItem.IsReligiousAspect,
			UniqueContentItem.IsOmen,
			UniqueContentItem.IsDecision,
			UniqueContentItem.IsReligiousOrderType,
			UniqueContentItem.IsCalling))]"

			block "unique_content_item_specific_bg" {}

			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)1.0', '(float)1.0')]"
			position = { 0 9% }

			widget = {
				ignore_layout = yes
				size = { 64 64 }
				parentanchor = center
				background = {
					using = bg_flat_bg_button_texture
					margin = {-4 -4}
					modify_texture = {using = color_dark_brown_texture}
					alpha = 0.7
				}
				background = {
					texture = "gfx/interface/component_tiles/lobby/country_lobby_flavor_frame_round.dds"
					texture_density = 2
				}
			}

			# ADVANCE
			icon = {
				visible = "[UniqueContentItem.IsAdvanceDefinition]"
				datacontext = "[UniqueContentItem.GetAdvanceDefinition]"
				block "country_culture_datacontext" {}

				parentanchor = center
				size = { 70% 70% }

				widget = {
					parentanchor = center
					size = { 100% 100% }
					visible = "[Not(AdvanceDefinition.HasSubunitUnlocks)]"
					datacontext = "[GetPlayer]"
					using = advance_icon_base
				}

				# Unit illustrations need a smaller scale than flat icons to avoid bleeding past the card frame
				widget = {
					parentanchor = center
					size = { 85% 85% }
					visible = "[AdvanceDefinition.HasSubunitUnlocks]"
					datacontext = "[GetPlayer]"
					using = advance_icon_base
				}
			}

			# LAW
			icon = {
				visible = "[UniqueContentItem.IsLaw]"
				parentanchor = center
				size = { 62% 62% }
				texture = "[GetLawIcon(UniqueContentItem.GetLaw)]"
			}

			# BUILDING
			icon = {
				visible = "[UniqueContentItem.IsBuildingType]"
				parentanchor = center
				size = { 50% 50% }
				texture = "[GetBuildingIcon(UniqueContentItem.GetBuildingType)]"
			}

			# COUNTRY INTERACTIONS
			icon = {
				visible = "[UniqueContentItem.IsCountryInteraction]"
				parentanchor = center
				size = { 62% 62% }
				texture = "gfx/interface/icons/flat_icons/tabicons/diplomacy.dds"
			}

			# DECISION
			icon = {
				visible = "[UniqueContentItem.IsDecision]"
				parentanchor = center
				size = { 62% 62% }
				texture = "[GetConceptTexture('decision')]"
			}

			# CABINET ACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCabinetAction]"

				cabinet_action_power = {
					datacontext = "[UniqueContentItem.GetCabinetAction]"
					parentanchor = center
					size = { 66% 66% }
					texture = "[GetCabinetActionIcon(CabinetAction.Self)]"
				}
			}

			# DISASTER
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsDisasterType]"

				icon = {
					datacontext = "[UniqueContentItem.GetDisasterType]"
					parentanchor = center
					size = { 100% 100% }
					texture = "[DisasterType.GetIcon]"
				}
			}

			# SITUATION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSituation]"

				icon = {
					datacontext = "[UniqueContentItem.GetSituation]"
					parentanchor = center
					size = { 75% 75% }
					texture = "[Situation.GetIcon]"
				}
			}

			# BUREAUCRACY TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsBureaucracyType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetBureaucracyType]"
					texture = "[GetBureaucracyIcon(BureaucracyType.Self)]"
				}
			}

			# CHARACTER INTERACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCharacterInteraction]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetCharacterInteraction]"
					texture = "[CharacterInteraction.GetIcon]"
				}
			}

			# FORMABLE COUNTRY
			widget = {
				parentanchor = center
				size = { 80% 80% }
				visible = "[UniqueContentItem.IsFormableCountry]"

				country_flag = {
					datacontext = "[UniqueContentItem.GetFormableCountry]"
					size = { 100% 66% }
					parentanchor = center

					blockoverride "tooltip" {
						tooltip_enabled = no
						tagtooltip_enabled = no
					}

					blockoverride "contextmenu" {
						contextmenu_enabled = no
					}

					blockoverride "flag" {
						datacontext = "[FormableCountry.GetOrCreateCoatOfArms(Player.Self)]"
						texture = "[CoatOfArmsWrapper.GetTexture('(int32)144','(int32)96')]"
						frame = "[CoatOfArmsWrapper.GetFrame('(int32)144','(int32)96')]"
						framesize = "[CoatOfArmsWrapper.GetFrameSizeOrFallback('(int32)144','(int32)96','(float)0.5')]"
						texture_density = 2
					}

					blockoverride "click" {}
					blockoverride "double_click" {}
					blockoverride "hover" {}
				}
			}

			# GENERIC ACTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsGenericAction]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetGenericAction]"
					texture = "[GenericAction.GetIcon]"
				}
			}

			# HEIR SELECTION
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsHeirSelection]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					texture = "[GetConceptTexture('heir_selection')]"
				}
			}

			# POLICY
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsPolicy]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetPolicy]"
					texture = "[GetLawIcon(Policy.GetLaw)]"
				}
			}

			# SOCIETAL VALUE TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSocietalValueType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					texture = "[GetConceptTexture('societal_value')]"
				}
			}

			# SUBJECT TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsSubjectType]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					texture = "[GetConceptTexture('subject_type')]"
				}
			}

			# TOWN RIGHTS TYPE
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsTownRightsType]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetTownRightsType]"
					texture = "[TownRightsType.GetIcon]"
				}
			}

			# RELIGIOUS ASPECT
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsReligiousAspect]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetReligiousAspect]"
					texture = "[GetReligiousAspectIcon(ReligiousAspect.Self)]"
				}
			}

			# OMEN
			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsOmen]"

				icon = {
					parentanchor = center
					size = { 100% 100% }
					datacontext = "[UniqueContentItem.GetOmen]"
					texture = "[GetOmenIcon(Omen.Self)]"
				}
			}

			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsReligiousOrderType]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					datacontext = "[UniqueContentItem.GetReligiousOrderType]"
					texture = "[ReligiousOrderType.GetIcon]"
				}
			}

			widget = {
				parentanchor = center
				size = { 62% 62% }
				visible = "[UniqueContentItem.IsCalling]"

				icon = {
					parentanchor = center
					size = { 75% 75% }
					datacontext = "[UniqueContentItem.GetCalling]"
					texture = "[Calling.GetIcon]"
				}
			}
		}

		# SUBUNIT DEFINITION
		widget = {
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.8181', '(float)0.80')]"
			parentanchor = center
			visible = "[UniqueContentItem.IsSubUnitDef]"
			widget = {
				size = { 48 60 }
				parentanchor = center
				datacontext = "[UniqueContentItem.GetSubUnitDef]"
				block "country_culture_datacontext" {}
				block "subunit_illustration" {
					using = unit_type_illustration_playable
				}

				widget = {
					ignore_layout = yes
					size = { 60 64 }
					parentanchor = center
					background = {
						using = bg_country_lobby_flavor_frame_texture
					}
				}
			}
		}

		# LEVY SETUP
		widget = {
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.8181', '(float)0.80')]"
			parentanchor = center
			visible = "[UniqueContentItem.IsLevySetup]"
			widget = {
				size = { 48 60 }
				parentanchor = center
				datacontext = "[UniqueContentItem.GetLevySetup.GetUnit]"
				block "country_culture_datacontext" {}
				block "subunit_illustration" {
					using = unit_type_illustration_playable
				}

				widget = {
					ignore_layout = yes
					size = { 60 64 }
					parentanchor = center
					background = {
						using = bg_country_lobby_flavor_frame_texture
					}
				}
			}
		}


		# GOV REFORM
		widget = {
			visible = "[UniqueContentItem.IsGovernmentReform]"
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.7143', '(float)0.72')]"
			parentanchor = center

			estate_reform_action_button_alt = {
				datacontext = "[UniqueContentItem.GetGovernmentReform]"
				size = { 44 60 }
				parentanchor = center
				blockoverride "estate_reform_button_visible" {
					visible = no
				}
				blockoverride "estate_reform_icon_visible" {
					visible = yes
				}
				blockoverride "icon_texture" {
					texture = "[GetGovernmentReformIllustration(GovernmentReform.Self)]"
				}
				blockoverride "reform_item_normal_visibility" {
					visible = "[And(Not(GovernmentReform.IsUnique),Not(GovernmentReform.IsMajor))]"
				}
				blockoverride "reform_item_unique_visibility" {
					visible = "[GovernmentReform.IsUnique]"
				}
				blockoverride "reform_item_major_visibility" {
					visible = "[And(Not(GovernmentReform.IsUnique),GovernmentReform.IsMajor)]"
				}
			}
		}


		# ESTATE PRIVILEGE
		widget = {
			size = "[PdxGuiWidget.KeepRatioFromWidthPercent('(float)0.7143', '(float)0.72')]"
			parentanchor = center
			visible = "[UniqueContentItem.IsEstatePrivilege]"

			widget = {
				datacontext = "[UniqueContentItem.GetEstatePrivilege]"
				size = { 100% 100% }

				icon = {
					parentanchor = center
					size = { 90% 90% }
					texture = "[GetEstatePrivilegeIcon(EstatePrivilege.Self)]"
				}

				icon = {
					size = { 100% 100% }

					background = {
						using = bg_frame_shadow_ep_texture
						using = color_dark_brown
					}

					background = {
						texture = "gfx/interface/buttons/estate_privileges/frame_2_ep.dds"
						using = color_dark_brown
						texture_density = 2
					}

					texture = "gfx/interface/buttons/estate_privileges/frame_1_ep.dds"
					texture_density = 2

					modify_texture = {
						using = color_new_gold_texture
						blend_mode = add
					}
				}
			}
		}
	}
}

template unique_content_item_header_bg {
	using = bg_card_header_01_advances
	blockoverride "header_advances_extra" {
		visible = "[UniqueContentItem.IsAdvanceDefinition]"
	}

	using = bg_card_header_01_government
	blockoverride "header_government_extra" {
		visible = "[Or5(
		UniqueContentItem.IsSituation,
		UniqueContentItem.IsGovernmentReform,
		UniqueContentItem.IsEstatePrivilege,
		UniqueContentItem.IsLaw,
		UniqueContentItem.IsCabinetAction)]"
	}

	using = bg_card_header_01_military
	blockoverride "header_military_extra" {
		visible = "[Or(UniqueContentItem.IsLevySetup, UniqueContentItem.IsSubUnitDef)]"
	}

	using = bg_card_header_01_production
	blockoverride "header_production_extra" {
		visible = "[UniqueContentItem.IsBuildingType]"
	}

	using = bg_card_header_01_diplomacy
	blockoverride "header_diplomacy_extra" {
		visible = "[Or(Or3(Or5(
		UniqueContentItem.IsCountryInteraction,
		UniqueContentItem.IsBureaucracyType,
		UniqueContentItem.IsCharacterInteraction,
		UniqueContentItem.IsFormableCountry,
		UniqueContentItem.IsGenericAction),
		Or5(
		UniqueContentItem.IsHeirSelection,
		UniqueContentItem.IsPolicy,
		UniqueContentItem.IsSocietalValueType,
		UniqueContentItem.IsSubjectType,
		UniqueContentItem.IsTownRightsType),
		UniqueContentItem.IsReligiousAspect),
		Or(UniqueContentItem.IsOmen,
		Or3(
		UniqueContentItem.IsReligiousOrderType,
		UniqueContentItem.IsCalling,
		UniqueContentItem.IsDecision)))]"
	}

	using = bg_card_header_01_hre
	blockoverride "bg_header_diplomacy_extra" {
		visible = "[UniqueContentItem.IsDisasterType]"
	}

	blockoverride "graphical_culture_pattern_texture" {
		texture = "[GetGraphicalCultureTexture('header_pattern')]"
	}
}

# Town rights (vanilla: in_game/gui/town_rights.gui)

template urban_rights_location_card {
	vbox = {
		layoutpolicy_horizontal = expanding
		margin = { 5 5 }
		spacing = 4

		hbox = {
			layoutpolicy_horizontal = expanding
			using = bg_card_header_01_production
			blockoverride "header_pattern_texture_density" {texture_density = 1.8}
			margin = { 10 5 }
			spacing = 6

			background = {
				texture = "gfx/interface/colors/whiteish.dds"
				blend_mode = overlay
				alpha = 0.1
			}

			icon = {
				size = { 22 22 }
				texture = "[Location.GetRankIcon]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				align = left|nobaseline
				using = Font_Size_Medium
				text = "[Location.GetName]"
			}

			text_single = {
				autoresize = yes
				align = right|nobaseline
				using = Font_Size_Medium
				raw_text = "[GetDataModelSize(Location.GetTownRights)]/[Location.GetPossibleTownRights]"

				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_text" {
							text = "LOCATION_TOWN_RIGHTS_TITLE"
						}

						blockoverride "concept_link" {
							text = "[town_rights|e]"
						}

						blockoverride "title_icon_texture" {
							texture = "[GetConceptTexture('town_rights')]"
						}

						blockoverride "tooltip_content" {
							TooltipStringPairList = {
								textcontext = "[Location.GetPossibleTownRightsInfo]"
							}
						}
					}
				}
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 8 2 }
			spacing = 4

			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 40 }
				hbox = {
					parentanchor = vcenter
					spacing = 4

					hbox = {
						spacing = 4
						datamodel = "[DataModelFirst(Location.GetTownRights, '(int32)10')]"
						item = {
							button = {
								size = { 40 40 }

								tooltipwidget = {
									using = TownRights_tooltip
								}

								background = {
									texture = "gfx/interface/component_tiles/town_rights_paper_background.dds"
									spriteType = Corneredstretched
									texture_density = 2
								}

								icon = {
									parentanchor = center
									size = { 34 34 }
									texture = "[TownRights.GetType.GetIcon]"
									texture_density = 2
								}

								action_tooltip = {
									click_type = left
									click_mode = confirm
									visible = "[TownRights.HasUpgradePath]"
									enabled = "[TownRights.CanUpgrade]"
									title = "UPGRADE_LOCATION_TOWN_RIGHT"
									conditions = "[TownRights.GetUpgradeConditions]"
									cost = "[TownRights.GetUpgradeCost]"
									on_action = "[TownRights.Upgrade]"
								}

								action_tooltip = {
									click_type = right
									click_mode = confirm
									enabled = "[TownRights.CanRevoke]"
									title = "REVOKE_LOCATION_TOWN_RIGHT"
									conditions = "[TownRights.GetRevokeConditions]"
									cost = "[TownRights.GetRevokeCost]"
									on_action = "[TownRights.Revoke]"
								}
							}
						}
					}

					text_single = {
						margin = { 6 0 }
						using = Font_Type_Headers
						raw_text = "+[Subtract_int32(GetDataModelSize(Location.GetTownRights), '(int32)10')]"
						align = nobaseline
						visible = "[GreaterThan_int32(GetDataModelSize(Location.GetTownRights), '(int32)10')]"
						using = bg_number_container_bckg
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" {
									text = "TOWN_RIGHTS_TEXT"
								}

								blockoverride "concept_link" {
									text = [town_rights|E]
								}

								blockoverride "title_icon_texture" {
									texture = "[GetConceptTexture('town_rights')]"
								}

								blockoverride "tooltip_layout_policy" { }

								blockoverride "tooltip_content" {
									TooltipListBase = {
										TooltipScrolledContentSection = {
											blockoverride "section_content" {
												vbox = {
													layoutpolicy_horizontal = expanding
													spacing = 2
													datamodel = "[DataModelSkipFirst(Location.GetTownRights, '(int32)10')]"
													item = {
														hbox = {
															layoutpolicy_horizontal = expanding
															minimumsize = { 180 24 }
															spacing = 6

															icon = {
																size = { 22 22 }
																texture = "[TownRights.GetType.GetIcon]"
															}

															text_single = {
																layoutpolicy_horizontal = expanding
																align = left|nobaseline
																text = "[TownRights.GetType.GetNameWithNoTooltip]"
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}

					expand = {}
				}
			}

			estate_add_reform_button = {
				size = { 30 38 }
				visible = "[And(Location.GetOwner.IsPlayer, Not(Location.GetRank.IsDefault))]"
				enabled = "[And(ShowGrantLocationTownRights(Location.Self), Not(Location.GetRank.IsDefault))]"
				blockoverride "estate_add_reform_button" {
					card_header_button_04 = {
						size = {100% 100%}
						action_tooltip = {
							click_type = left
							click_mode = single
							title = "GRANT_NEW_TOWN_RIGHTS"
							on_action = "[GrantLocationTownRights(Location.Self)]"
							conditions = "[AddLocalizationIf(Not(Location.GetOwner.IsPlayer), 'TWR_NOT_OTHER_COUNTRY_LOCATIONS')]"
							conditions = "[AddLocalizationIf(And(Location.GetOwner.IsPlayer, Location.GetRank.IsDefault), 'TWR_ONLY_URBAN_LOCATIONS')]"
							conditions = "[AddLocalizationIf(And3(Location.GetOwner.IsPlayer, Not(Location.GetRank.IsDefault), Not(ShowGrantLocationTownRights(Location.Self))), 'TWR_NOT_CAPABLE')]"
							enabled = "[And(ShowGrantLocationTownRights(Location.Self), Not(Location.GetRank.IsDefault))]"
						}

						tooltipwidget = {
							BasicFunctionalTooltip = {}
						}
					}
				}
			}
		}
	}
}

template town_rights_type_item {
	card_header_button_pinned = {

		block "item_size" {
			size = { 47 43 }
		}

		tooltipwidget = {
			using = TownRightsItem_tooltip
		}

		action_tooltip = {
			click_type = right
			click_mode = confirm
			enabled = "[TownRightsItem.CanRevokeFirst]"
			title = "REVOKE_TOWN_RIGHTS_FROM"
			conditions = "[TownRightsItem.GetRevokeFirstConditions]"
			cost = "[TownRightsItem.GetRevokeFirstCost]"
			on_action = "[TownRightsItem.RevokeFirst]"
		}

		action_tooltip = {
			click_type = left
			click_mode = confirm
			visible = "[TownRightsItem.HasUpgradePath]"
			enabled = "[TownRightsItem.CanUpgradeFirst]"
			title = "UPGRADE_TOWN_RIGHTS_TO"
			conditions = "[TownRightsItem.GetUpgradeFirstConditions]"
			cost = "[TownRightsItem.GetUpgradeCost]"
			on_action = "[TownRightsItem.UpgradeFirst]"
		}

		icon = {
			parentanchor = center
			size = { 28 28 }
			texture = "[TownRightsItem.GetType.GetIcon]"
			texture_density = 2
		}

		text_single = {
			visible = "[GreaterThan_int32(TownRightsItem.GetLocationsAmount, '(int32)1')]"
			using = Font_Size_Small
			parentanchor = bottom|hcenter
			widgetanchor = vcenter|hcenter
			position = { 0 0 }
			autoresize = yes
			align = center|nobaseline
			text = "[TownRightsItem.GetLocationsAmount]"

			background = {
				texture = "gfx/interface/component_tiles/urban_rights_amount_bg.dds"
				texture_density = 2
				spriteType = corneredstretched
				spriteborder = { 14 14 }
				margin = { 6 3 }
				margin_top = 0
				margin_bottom = 5
			}
		}
	}
}

