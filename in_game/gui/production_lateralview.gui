template production_view_poptypes {
	hbox = {
		layoutpolicy_horizontal = expanding
		spacing = 2
        margin_left = 2 # GlorpUI: Change Margin
        margin_right = 2
        margin_top = -10
        margin_bottom = 5
		visible = "[And3(Not(ProductionView.Vars.HasValue( 'display', 'foreign' )), Not(ProductionView.Vars.HasValue( 'display', 'estate' )), ProductionView.IsLocationFilterEnabled)]"
		datamodel = "[GetPopTypes]"
		datacontext = "[ProductionView.GetSelectedLocation]"

        hbox = { # GlorpUI: Extra Piecharts
            piechart = {
                using = bg_circle
                visible = "[Not(Location.HasTooManyBuildingLevel)]"
                size = { 30 30 }
                datacontext = "[ProductionView.GetSelectedLocation]"
                tooltipwidget = {
                    using = LocationBuildingLevels_tooltip
                }
                using = piechart_angles

                pieslice_no_highlight = {

                    texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
                    value = "[ProductionView.GetSelectedLocation.GetBuildingLevelsPercentage]"
                    color = { 1 1 1 1 }
                }

                pieslice_no_highlight = {
                    texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
                    value = "[Subtract_float('(float)100.0', ProductionView.GetSelectedLocation.GetBuildingLevelsPercentage)]"
                    color = { 1 1 1 1 }
                }
                using = bg_circle_piechart

                icon = {
                    size = { 59% 59% }
                    parentanchor = center
                    texture = "[GetConceptTexture('supported_building_levels')]"
                }
            }

            piechart = {
                visible = "[Location.HasTooManyBuildingLevel]"
                using = bg_circle
                size = { 30 30 }
                datacontext = "[ProductionView.GetSelectedLocation]"
                tooltipwidget = {
                    using = LocationBuildingLevels_tooltip
                }
                using = piechart_angles


                pieslice_no_highlight = {

                    texture = "gfx/interface/pie_charts/pie_chart_alpha_80_red.dds"
                    value = 100
                    color = { 1 1 1 1 }
                }
                using = bg_circle_piechart

                icon = {
                    size = { 59% 59% }
                    parentanchor = center
                    texture = "gfx/interface/icons/outliner/categories/buildings.dds"
                }
            }
        }

		item = {
			# ESTATES FILTERS
			estates_filter_button = {
				visible = "[ShowBuildingCardForLocation(Location.Self, PopType.Self)]"
				blockoverride "building_color" {
					color = "[PopType.GetColor]"
					alpha = 0.8
					blend_mode = overlay
				}
				blockoverride "estates_filter_button_action" {
					action_tooltip = {
						click_type = left
						click_mode = single
						on_action = "[SearchBar.ToggleFilterByKeyForceExclusive(PopType.GetKey)]"
						on_action = "[ShowProductionViewWithLocation(Location.GetId, '(bool)no')]"
						datacontext = "[PopType]"
						title = "TOGGLE_BUILDINGS_POP_TYPE"
					}

					action_tooltip = {
						click_type = right
						title = "[SelectLocalization(SearchBar.IsFilterPinnedByKey(PopType.GetKey), 'UNPIN_FILTER', 'PIN_FILTER')]"
						on_action = "[SearchBar.ToggleFilterPinByKey(PopType.GetKey)]"
					}
				}
				blockoverride "estates_filter_button_texture" {
					texture = "[GetGraphicalCultureTextureForCountryPopType(PopType.Self, Location.GetOwner.Self)]"
				}
				blockoverride "estates_filter_button_pin" {
					widget = {
						size = { 14 14 }
						datacontext = "[ProductionView.GetBuildingsSortSearch.GetSearchBar]"
						using = estates_filter_button_pin_overlay
					}
				}
				blockoverride "estates_filter_button_searchbar_datacontext" {
					datacontext = "[ProductionView.GetBuildingsSortSearch.GetSearchBar]"
				}
			}
		}
	}
	hbox = {
		layoutpolicy_horizontal = expanding
		spacing = 2
		margin = { 2 0 }
		margin_bottom = 3
		visible = "[And3(Not(ProductionView.Vars.HasValue( 'display', 'foreign' )),  Not(ProductionView.Vars.HasValue( 'display', 'estate' )), Not(ProductionView.IsLocationFilterEnabled))]"
		datamodel = "[GetPopTypes]"
		datacontext = "[ProductionView.GetSelectedLocation]"

		card_header_button_04 = {
			size = { 30 30 }
			using = bg_card_header_01
			blockoverride "bg_card_header_01_margins" {}
			blockoverride "header_pattern" {
				texture = "gfx/interface/cards/headers/header_pattern_04.dds"
				alpha = 0.1
			}
			action_tooltip = {
				click_type = left
				click_mode = single
				# on_action = "[OpenLateralViewWithFilter('production', 'can_build_any_building')]"
				on_action = "[SearchBar.ToggleFilterByKey('can_build_any_building')]"
				title = "SHOW_BUILDABLE_BUILDINGS"
			}
			tooltipwidget = { BasicFunctionalTooltip = {} }

			icon = {
				name = "filter_is_on"
				using = color_white_texture
				alpha = 0.3
				size = { 100% 100% }
				visible = "[SearchBar.IsFilterEnabledByKey('can_build_any_building')]"
			}

			icon = {
				parentanchor = center
				size = { 22 22 }
				texture = "gfx/interface/icons/flat_icons/building_panel/build_visible.dds"
			}
		}

		item = {
			# ESTATES FILTERS
			estates_filter_button = {
				blockoverride "building_color" {
					color = "[PopType.GetColor]"
					alpha = 0.8
					blend_mode = overlay
				}
				blockoverride "estates_filter_button_inner_content" {}
				blockoverride "estates_filter_button_tooltip" {
					# tooltipwidget = { BasicFunctionalTooltip = {} }

					action_tooltip = {
						click_type = right
						title = "[SelectLocalization(SearchBar.IsFilterPinnedByKey(PopType.GetKey), 'UNPIN_FILTER', 'PIN_FILTER')]"
						on_action = "[SearchBar.ToggleFilterPinByKey(PopType.GetKey)]"
					}

					tooltipwidget = {
						using = pop_filter_button_tt
					}
				}
				blockoverride "estates_filter_button_pin" {
					widget = {
						size = { 14 14 }
						datacontext = "[ProductionView.GetBuildingsSortSearch.GetSearchBar]"
						using = estates_filter_button_pin_overlay
					}
				}
				blockoverride "estates_filter_button_searchbar_datacontext" {
					datacontext = "[ProductionView.GetBuildingsSortSearch.GetSearchBar]"
				}
			}
		}
	}
}

@building_entry_height = 40 # Vanilla = 44 (not 48, cause of different spacing)
lateralview = {
	name = "production_lateralview"
	widgetid = "production_lateralview"

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }

			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }


				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_production')]"
				}

				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "THE_PRODUCTION_OVERVIEW_TITLE"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_production_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = { #
			blockoverride "content" {
				using = production_main_tabs
			}
		}

		widget = {
			using = layoutpolicy_expanding

			vbox = {
				using = bg_main_inner_alt
				using = bg_main_inner_image_alt

				blockoverride "image" {
					texture = "gfx/interface/illustrations/bg/bg_production.dds"
				}
				using = window_main_tabs_margin_alt

				#All Building Types
				filtered_sorted_list = {
					margin_top = 10
					visible = "[ProductionView.Vars.NotExistOrHasValue( 'display', 'lists' )]"
					datacontext = "[ProductionView.GetBuildingsSortSearch.WithFilterTags('building')]"
					name = "production_filtered_list"

					blockoverride "subheader_upper_divider"{
						# MARKET FILTERED
						widget = {
							visible = "[ProductionView.IsMarketFilterEnabled]"
							layoutpolicy_horizontal = expanding
							size = { -1 70 }

							hbox = {
								datacontext = "[ProductionView.GetSelectedMarket]"


								using = bg_market_card
								using = bg_cabinet_card_frame

								market_card = {
									blockoverride "market_card_margins" {
										margin = {5 5}
										margin_right = 0
									}
								}

								market_card_right_buttons = {
									blockoverride "market_filter_buttons" {
										vbox = {
											layoutpolicy_vertical = expanding
											spacing = 3

											filter_button_alt = {
												size = { 23 23 }
												blockoverride "filter_button_action" {
													action_tooltip = {
														click_type = left
														click_mode = single
														title = "TOGGLE_MARKET_SELECTION"
														on_action = "[ProductionView.ToggleProductionSelectMarket(PdxGuiWidget.FindParent('production_filtered_list').Self)]"
													}

													action_tooltip = {
														click_type = right
														click_mode = single
														title = "SCROLL_CAPITAL_MARKET_FILTER"
														on_action = "[SelectDefaultFocusMarket]"
													}
												}
												tooltipwidget = { BasicFunctionalTooltip = {} }

												blockoverride "glow_visible" {
													visible = "[ProductionView.IsProductionSelectMarketOpened(PdxGuiWidget.FindParent('production_filtered_list').Self)]"
												}
											}

											button = {
												using = market_filter_button
												enabled = "[ProductionView.IsMarketFilterEnabled]"
												blockoverride "functional_tooltip" {
													tooltipwidget = { BasicFunctionalTooltip = {} }

													action_tooltip = {
														click_type = left
														click_mode = single
														enabled = "[ProductionView.IsMarketFilterEnabled]"
														title = "REMOVE_MARKET_FILTER"
														on_action = "[ProductionView.RemoveMarketFilter]"
													}
												}
											}
										}
									}
								}
							}
						}

						# MARKET NOT FILTERED
						widget = {
							visible = "[Not(ProductionView.IsMarketFilterEnabled)]"
							layoutpolicy_horizontal = expanding
							size = { -1 50 }

							button_regular = {
								size = { 100% 50 }

								action_tooltip = {
									click_type = left
									click_mode = single
									title = "TOGGLE_MARKET_SELECTION"
									on_action = "[ProductionView.ToggleProductionSelectMarket(PdxGuiWidget.FindParent('production_filtered_list').Self)]"
								}

								action_tooltip = {
									click_type = right
									click_mode = single
									title = "SCROLL_CAPITAL_MARKET_FILTER"
									on_action = "[SelectDefaultFocusMarket]"
								}

								tooltipwidget = { BasicFunctionalTooltip = {} }

								hbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									spacing = 5

									margin_left = 8
									margin_right = 5

									text_single = {
										align = center|nobaseline
										layoutpolicy_horizontal = expanding
										autoresize = no
										fontsize_min = 12
										text = "NOT_FILTERED_BY_MARKET"
									}
								}


								filter_button_alt = {
									parentanchor = right|vcenter
									position = {-10 0}
									size = { 25 25 }
									blockoverride "filter_button_action" {
										action_tooltip = {
											click_type = left
											click_mode = single
											title = "TOGGLE_MARKET_SELECTION"
											on_action = "[ProductionView.ToggleProductionSelectMarket(PdxGuiWidget.FindParent('production_filtered_list').Self)]"
										}

										action_tooltip = {
											click_type = right
											click_mode = single
											title = "SCROLL_CAPITAL_MARKET_FILTER"
											on_action = "[SelectDefaultFocusMarket]"
										}
									}
									tooltipwidget = { BasicFunctionalTooltip = {} }

									blockoverride "glow_visible" {
										visible = "[ProductionView.IsProductionSelectMarketOpened(PdxGuiWidget.FindParent('production_filtered_list').Self)]"
									}
								}
							}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							using = production_view_subtabs
						}
					}

					blockoverride "searchbar_extra_pre_content"{
						using = production_view_poptypes
					}

					blockoverride "scroll_list_is_empty" {
						visible = "[And(IsDataModelEmpty(ProductionView.GetBuildingItems), ProductionView.Vars.NotExistOrHasValue( 'display', 'lists' ))]"
					}

					blockoverride "scroll_list_is_empty_text" {
						text = "BUILDINGS_SCROLL_LIST_EMPTY"
					}

					blockoverride "sort_buttons_filtered_list" {
						sort_by_key_button = {
							name = "name"
							using = layoutpolicy_expanding
						}

						# sort_by_key_button = {
						# 	name = "profit"
						# 	layoutpolicy_vertical = expanding
						# 	size = { 140 -1 }
						# }

						sort_by_key_button = {
							name = "income"
							layoutpolicy_vertical = expanding
							size = { 140 -1 }
						}

						sort_by_key_button = {
							name = "level"
							layoutpolicy_vertical = expanding
							size = { 130 -1 }
						}
					}

					blockoverride "scroll_list_content" {
						visible = "[ProductionView.Vars.NotExistOrHasValue( 'display', 'lists' )]"
						datamodel = "[ProductionView.GetBuildingItems]"
						addcolumn = 100%
						addrow = @building_entry_height
						datamodel_reuse_widgets = yes
						item = {
							widget = {
								size = { 100% @building_entry_height }
								vbox = {
									# CM: margin_top 5 removed, row height comes from @building_entry_height
									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 3

										building_type_header = { layoutpolicy_horizontal = expanding }

										widget = {
											size = { 35 @[building_entry_height - 5] } # CM: vanilla 35 40, matches the building_type_header height
											onmousehierarchyenter = "[ProductionView.RebuildBuildRankingItems(BuildingItem.GetBuildingType)]"
											using = bg_building_card_colors
											blockoverride "header_pattern_texture_density" { texture_density = 2.5 }

											card_header_button_04 = {
												parentanchor = center
												size = { 100% 100% }
												datacontext = "[BuildingItem.GetBuildingType]"
												datacontext = "[ProductionView.GetBuildRankingItems]"

												enabled = "[Or3(And(Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)), Or(BuildingItem.CanBuildAnyBuilding, ProductionView.HasUpgradableFromCurrentTier(BuildingItem.GetBuildingType))), And(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType), ProductionView.CanMassUpgrade(BuildingItem.GetBuildingType)), BuildingItem.AreBuildingsUnderConstruction)]"

												icon = {
													parentanchor = center
													size = { 24 24 }
													visible = "[And(Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)), Not(ProductionView.HasUpgradableFromCurrentTier(BuildingItem.GetBuildingType)))]"
													texture = "gfx/interface/icons/flat_icons/mass_construct.dds"
												}
												icon = {
													parentanchor = center
													size = { 24 24 }
													visible = "[And(Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)), ProductionView.HasUpgradableFromCurrentTier(BuildingItem.GetBuildingType))]"
													texture = "gfx/interface/icons/flat_icons/mass_construct_upgrade.dds"
												}
												icon = {
													parentanchor = center
													size = { 24 24 }
													visible = "[Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)]"
													texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
												}

												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = default
													visible = "[And(BuildingItem.CanBuildAnyBuilding, Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)))]"
													enabled = "[ProductionView.HasBestBuildLocationFor(BuildingItem.GetBuildingType)]"
													title = "BUILDING_BEST_IN_LOCATION_ACTION_BUTTON"
													on_action = "[ProductionView.BuildBestFromRankingItemsDefault(BuildingItem.GetBuildingType)]"
													on_action = "[PlayAudioEffect('UI_action_building_build')]"
												}
												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = ctrl
													visible = "[And(BuildingItem.CanBuildAnyBuilding, Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)))]"
													enabled = "[ProductionView.HasBestBuildLocationFor(BuildingItem.GetBuildingType)]"
													title = "BUILD_IN_BEST_LOCATION_ACTION_CTRL"
													on_action = "[ProductionView.BuildBestFromRankingItemsCtrl(BuildingItem.GetBuildingType)]"
													on_action = "[PlayAudioEffect('UI_action_building_build')]"
												}
												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = shift
													visible = "[And(BuildingItem.CanBuildAnyBuilding, Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)))]"
													enabled = "[ProductionView.HasBestBuildLocationFor(BuildingItem.GetBuildingType)]"
													title = "BUILD_IN_BEST_LOCATION_ACTION_SHIFT"
													on_action = "[ProductionView.BuildBestFromRankingItemsShift(BuildingItem.GetBuildingType)]"
													on_action = "[PlayAudioEffect('UI_action_building_build')]"
												}

												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = default
													visible = "[And(Not(BuildingItem.CanBuildAnyBuilding), Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)))]"
													enabled = no
													title = "BUILDING_BEST_IN_LOCATION_ACTION_BUTTON"
													description = "BUILDING_IN_LOCATION_ACTION_NO_LOCATION"
												}

												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = alt
													visible = "[Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType))]"
													enabled = "[ProductionView.HasUpgradableFromCurrentTier(BuildingItem.GetBuildingType)]"
													title = "UPGRADE_OBSOLETE_FROM_CURRENT_ACTION"
													description = "UPGRADE_OBSOLETE_FROM_CURRENT_ACTION_DESC"
													on_action = "[ProductionView.UpgradeObsoleteFromCurrentTier(BuildingItem.GetBuildingType)]"
													on_action = "[PlayAudioEffect('UI_action_building_build')]"
												}

												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = default
													visible = "[And(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType), ProductionView.CanMassUpgrade(BuildingItem.GetBuildingType))]"
													enabled = "[ProductionView.CanMassUpgrade(BuildingItem.GetBuildingType)]"
													title = "UPGRADING_BEST_IN_LOCATION_ACTION_BUTTON"
													on_action = "[ProductionView.BuildBestFromRankingItemsDefault(BuildingItem.GetBuildingType)]"
													on_action = "[PlayAudioEffect('UI_action_building_build')]"
												}
												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = default
													visible = "[And(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType), Not(ProductionView.CanMassUpgrade(BuildingItem.GetBuildingType)))]"
													enabled = no
													title = "UPGRADING_BEST_IN_LOCATION_ACTION_BUTTON"
													description = "UPGRADING_IN_LOCATION_ACTION_NO_LOCATION_PROD"
												}
												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = ctrl
													visible = "[Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)]"
													enabled = "[ProductionView.CanMassUpgrade(BuildingItem.GetBuildingType)]"
													title = "UPGRADE_IN_BEST_LOCATION_ACTION_CTRL"
													on_action = "[ProductionView.BuildBestFromRankingItemsCtrl(BuildingItem.GetBuildingType)]"
													on_action = "[PlayAudioEffect('UI_action_building_build')]"
												}
												action_tooltip = {
													click_type = left
													click_mode = single
													click_modifier = shift
													visible = "[Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)]"
													enabled = "[ProductionView.CanMassUpgrade(BuildingItem.GetBuildingType)]"
													title = "UPGRADE_IN_BEST_LOCATION_ACTION_SHIFT"
													on_action = "[ProductionView.BuildBestFromRankingItemsShift(BuildingItem.GetBuildingType)]"
													on_action = "[PlayAudioEffect('UI_action_building_build')]"
												}

												action_tooltip = {
													click_type = right
													click_mode = single
													click_modifier = default
													visible = "[ProductionView.HasLastBuildLocationItemFor(BuildingItem.GetBuildingType)]"
													title = "DEQUEUE_LAST_BUILDING_ACTION"
													description = "[GetCancelConstructionInfo(ProductionView.GetBuildRankingItems.GetLastConstruction)]"
													on_action = "[CancelConstruction(ProductionView.GetBuildRankingItems.GetLastConstruction)]"
												}
												action_tooltip = {
													click_type = right
													click_mode = single
													click_modifier = default
													visible = "[Not(ProductionView.HasLastBuildLocationItemFor(BuildingItem.GetBuildingType))]"
													enabled = no
													title = "DEQUEUE_LAST_BUILDING_ACTION"
													description = "DEQUEUE_BUILDING_PRODUCTION_ACTION_NONE"
												}
												action_tooltip = {
													click_type = right
													click_mode = single
													click_modifier = ctrl
													visible = "[ProductionView.HasLastBuildLocationItemFor(BuildingItem.GetBuildingType)]"
													title = "DEQUEUE_LATESTS_BUILDING_TYPE_ACTION"
													description = "[GetCancelConstructionInfo(ProductionView.GetBuildRankingItems.GetLastConstruction)]"
													on_action = "[ProductionView.CancelAllLastBuildLocations]"
												}
												action_tooltip = {
													click_type = right
													click_mode = single
													click_modifier = ctrl
													visible = "[Not(ProductionView.HasLastBuildLocationItemFor(BuildingItem.GetBuildingType))]"
													enabled = no
													title = "DEQUEUE_LATESTS_BUILDING_TYPE_ACTION"
													description = "DEQUEUE_BUILDING_PRODUCTION_ACTION_NONE"
												}

												tooltipwidget = {
													using = mass_build_ranking_and_dequeue_tt
													blockoverride "extra_build_content" {
														TooltipTextBlock = {
															visible = "[And(Not(Player.CanUpgradeBuildingType(BuildingItem.GetBuildingType)), GreaterThan_int32(ProductionView.GetTotalRemainingUpgradeLevels(BuildingItem.GetBuildingType), '(int32)0'))]"
															blockoverride "text" {
																text = "BUILDING_MASS_UPGRADE_REMAINING_PROD"
															}
															blockoverride "textblock_background_tint" {
																modify_texture = {
																	using = color_turquoise_texture
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				#Building Categories
				filtered_sorted_list = {
					margin_top = 10
					visible = "[ProductionView.Vars.HasValue( 'display', 'cards' )]"
					datacontext = "[ProductionView.GetBuildingsSortSearch.WithFilterTags('building')]"
					name = "building_categories_filtered_list"

					blockoverride "subheader_upper_divider" {
						# MARKET FILTERED
						widget = {
							visible = "[ProductionView.IsMarketFilterEnabled]"
							layoutpolicy_horizontal = expanding
							size = { -1 70 }

							hbox = {
								datacontext = "[ProductionView.GetSelectedMarket]"


								using = bg_market_card
								using = bg_cabinet_card_frame

								market_card = {
									blockoverride "market_card_margins" {
										margin = {5 5}
										margin_right = 0
									}
								}

								market_card_right_buttons = {
									blockoverride "market_filter_buttons" {
										vbox = {
											layoutpolicy_vertical = expanding
											spacing = 3

											filter_button_alt = {
												size = { 23 23 }
												blockoverride "filter_button_action" {
													action_tooltip = {
														click_type = left
														click_mode = single
														title = "TOGGLE_MARKET_SELECTION"
														on_action = "[ProductionView.ToggleProductionSelectMarket(PdxGuiWidget.FindParent('building_categories_filtered_list').Self)]"
													}

													action_tooltip = {
														click_type = right
														click_mode = single
