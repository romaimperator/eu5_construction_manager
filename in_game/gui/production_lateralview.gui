	type location_filtered_header_with_candidate = hbox {
		# !!! for performance, it's important that location_filtered_header_with_candidate and location_filtered_header_no_candidate have the same size !!!
		block "location_filtered_header_with_candidate_visible" {
			visible = "[And(ProductionView.IsLocationFilterEnabled, Not(IsDataModelEmpty(BuildingItem.GetBuildingCandidates)))]"
		}
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		ignoreinvisible = yes

		datamodel = "[BuildingItem.GetBuildingCandidates]"
		item = {
			widget = {
				size = { -1 60 }
				layoutpolicy_horizontal = expanding

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					using = bg_cabinet_card_frame
					margin = {2 5}
					margin_right = 4
					margin_bottom = 3

					datacontext = "[BuildingCandidate.GetBuilding]"
					datacontext = "[Building.GetType]"
					datacontext = "[Building.GetLocation]"

					# icon
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						layoutstretchfactor_horizontal = 1

						using = bg_building_card_colors
						blockoverride "building_color" {
							color = "[BuildingItem.GetBuildingType.GetPopType.GetColor]"
							alpha = 0.7
							blend_mode = overlay
						}
						ignoreinvisible = yes

						widget = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							icon = {
								size = {100% 100%}
								ignore_layout = yes
								visible = "[BuildingItem.GetBuildingType.GetPopType.IsClergy]"
								using = color_black_texture
								alpha = 0.2
							}

							vbox = {
								card_header_button_04 = {
									size = { 55 -1 }
									layoutpolicy_vertical = expanding
									datacontext = "[BuildingItem.GetBuildingType]"

									action_tooltip = {
										click_type = left
										click_mode = single
										title = "OPEN_PROD_METHOD_BUILDING_ITEM_LOCATION"
										on_action = "[BuildingCandidate.ShowBuilding]"
									}

									action_tooltip = {
										click_type = right
										click_mode = single
										title = "BUILD_BUILDING"
										on_action = "[SelectLocationToBuildDefault(BuildingItem.GetBuildingType)]"
									}

									tooltipwidget = {
										using = Building_tooltip
									}
									piechart = {
										using = bg_circle
										size = { 36 36 }
										parentanchor = center
										datacontext = "[BuildingCandidate.GetBuilding]"
										using = piechart_angles

										using = building_employment_piechart_data

										icon = {
											size = { 55% 55% }
											parentanchor = center
											texture = "[GetBuildingIcon(BuildingItem.GetBuildingType.Self)]"
											glow = {
												name = "drop_shadow"
												glow_radius = 3
												color = {0.0 0.0 0.0 1.0}
												alpha = 0.3
											}
										}
										sort_by_highlight = {
											name = "name"
										}
									}
								}
							}

							icon = {
								position = { 0 -2 }
								parentanchor = hcenter
								using = warning_icon_texture
								size = { 15 15 }
								visible = "[BuildingItem.HasBuildingsLackingInput]"
								using = bg_circle
							}

							widget = {
								size = { 22 14 }
								parentanchor = bottom|left
								position = { 2 -2 }
								visible = "[BuildingCandidate.IsForeign]"
								datacontext = "[BuildingCandidate.GetBuilding.GetOwner]"

								country_flag_mini = {
									parentanchor = center
								}
							}
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						layoutstretchfactor_horizontal = 8
						ignoreinvisible = yes
						spacing = 0

						widget = {
							layoutpolicy_horizontal = expanding
							size = { -1 50 }

							tooltipwidget = {
								using = Building_tooltip
							}

							using = bg_building_card_colors
							blockoverride building_color_card_margins {}
							blockoverride building_color_grey_margins {}
							blockoverride "building_main_texture" {
								using = color_grey_texture
							}
							blockoverride "building_color" {
								color = "[BuildingItem.GetBuildingType.GetPopType.GetColor]"
								alpha = 0.7
								blend_mode = overlay
							}

							icon = {
								size = {100% 100%}
								visible = "[BuildingItem.GetBuildingType.GetPopType.IsClergy]"
								using = color_black_texture
								alpha = 0.2
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								maximumsize = { -1 50 }
								ignoreinvisible = yes
								spacing = 6
								margin_left = 3
								margin_right = 3

								vbox = { #name
									spacing = 4
									margin_top = 1

									hbox = {
										size = {-1 15}
										layoutpolicy_horizontal = expanding

										text_single = {
											autoresize = no
											size = { 120 15 }
											align = left|nobaseline
											default_format = "#yellow_titles"
											text = "[BuildingCandidate.GetBuilding.GetName]"
											datacontext = "[BuildingCandidate.GetBuilding]"
											tooltipwidget = {
												using = Building_tooltip
											}
										}

										expand = {}
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 3
										maximumsize = {-1 15}
										datacontext = "[BuildingType.GetPopType]"

										text_single = {
											autoresize = yes
											align = left|nobaseline
											fontsize = 14
											raw_text = "[BuildingCandidate.GetBuilding.GetEmploymentSize]/[BuildingCandidate.GetBuilding.GetMaxWorkersRequired]"
											# default_format = "#W"
											datacontext = "[BuildingCandidate.GetBuilding]"
											tooltipwidget = {
												using = Building_tooltip
											}
										}
										icon = {
											size = { 12 12 }
											texture = "[GetGraphicalCultureTextureForCountryPopType(PopType.Self, Location.GetOwner.Self)]"
											glow = {
												name = "drop_shadow"
												glow_radius = 5
												color = {0.0 0.0 0.0 1.0}
												alpha = 0.5
											}
										}

										expand = {}
									}
								}

								expand = {}

								hbox = {
									spacing = 4

									vbox = {
										margin = { 5 0 }
										ignoreinvisible = yes

										button_square_checkbox = {
											visible = "[And(BuildingItem.HasBuildings, BuildingItem.GetBuildingType.IsProducing)]"
											size = { 20 16 }
											enabled = "[CanSubsidizeBuildings(BuildingItem.GetBuildingsFunc)]"
											tooltipwidget = {
												using = Building_Subsidized_Tooltip
											}

											blockoverride "check_texture" {
												texture = "gfx/interface/icons/flat_icons/building_panel/subsidized.dds"
											}
											blockoverride "checked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "unchecked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "checked_visible" {
												visible = "[AreBuildingsSubsidized(BuildingItem.GetBuildingsFunc)]"
											}
											blockoverride "unchecked_visible" {
												visible = "[Not(AreBuildingsSubsidized(BuildingItem.GetBuildingsFunc))]"
											}
											background = {
												texture = "gfx/interface/buttons/checkbox_bg_square.dds"
												texture_density = 2

												modify_texture = {
													using = color_market_grey_texture
													blend_mode = add
													alpha = 0.5
												}
											}

											action_tooltip = {
												on_action = "[ToggleSubsidizeBuildings(BuildingItem.GetBuildingsFunc)]"
												on_action = "[PlayAudioEffect(Concatenate('UI_action_building_subsidize', GetToggleSuffix(AreBuildingsSubsidized(BuildingItem.GetBuildingsFunc))))]"
												enabled = "[CanSubsidizeBuildings(BuildingItem.GetBuildingsFunc)]"
												title = "[SelectLocalization( BuildingCandidate.GetBuilding.IsSubsidized, 'TOGGLE_SUBSIDIZE_ON', 'TOGGLE_SUBSIDIZE_OFF' )]"
											}
										}

										button_square_checkbox = {
											visible = "[And(BuildingItem.HasBuildings, BuildingItem.ShowCloseAll)]"
											size = { 20 16 }
											enabled = "[CanToggleBuildings(BuildingItem.GetBuildingsFunc)]"
											tooltipwidget = {
												using = Building_Open_Tooltip
											}

											blockoverride "check_texture" {
												texture = "gfx/interface/icons/achievements/padlock.dds"
											}
											blockoverride "checked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "unchecked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "checked_visible" {
												visible = "[AreBuildingsClosed(BuildingItem.GetBuildingsFunc)]"
											}
											blockoverride "unchecked_visible" {
												visible = "[Not(AreBuildingsClosed(BuildingItem.GetBuildingsFunc))]"
											}
											background = {
												texture = "gfx/interface/buttons/checkbox_bg_square.dds"
												texture_density = 2

												modify_texture = {
													using = color_market_grey_texture
													blend_mode = add
													alpha = 0.5
												}
											}

											action_tooltip = {
												on_action = "[ToggleBuildings(BuildingItem.GetBuildingsFunc)]"
												enabled = "[CanToggleBuildings(BuildingItem.GetBuildingsFunc)]"
												title = "[SelectLocalization( BuildingCandidate.GetBuilding.IsOpen, 'TOGGLE_CLOSE_ON', 'TOGGLE_CLOSE_OFF' )]"
											}
										}

										# GlorpUI: Construction Manager auto-expand button
										# CM: 1.4 moved auto-expand into this 20x16 checkbox column, so the button is sized to match instead of using the 20x44 _pl slot
										cm_auto_expand_existing_building_button = {
											visible = "[And3(ObjectsEqual(Building.GetOwner, Player.Self), Building.GetType.IsMultipleLevels, Not(GetScriptedGui('cm_is_building_obsolete').IsShown(GuiScope.SetRoot(Building.MakeScope).End)))]"
											size = { 20 16 }
											blockoverride "checked_icon_size" { size = { 14 14 } }
											blockoverride "unchecked_icon_size" { size = { 14 14 } }
										}
										button_square_checkbox = {
											# GlorpUI: hidden when Construction Manager is active
											visible = "[And3(Not(GetScriptedGui('glorpui_is_cm_active').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), ObjectsEqual(Building.GetOwner, Player.Self), BuildingType.IsMultipleLevels)]"
											size = { 20 16 }
											tooltipwidget = { using = AutoExpand_Building_Tooltip }

											blockoverride "check_texture" {
												texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds"
											}
											blockoverride "checked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "unchecked_icon_size" {
												size = { 14 14 }
											}
											blockoverride "checked_visible" {
												visible = "[IsAutoExpand(Building.Self)]"
											}
											blockoverride "unchecked_visible" {
												visible = "[Not(IsAutoExpand(Building.Self))]"
											}
											background = {
												texture = "gfx/interface/buttons/checkbox_bg_square.dds"
												texture_density = 2

												modify_texture = {
													using = color_market_grey_texture
													blend_mode = add
													alpha = 0.5
												}
											}

											action_tooltip = {
												click_type = left
												title = "[SelectLocalization(IsAutoExpand(Building.Self), 'TOGGLE_AUTO_EXPAND_ON', 'TOGGLE_AUTO_EXPAND_OFF')]"
												on_action = "[ToggleAutoExpandBuilding(Building.Self)]"
												description = "[GetAutoExpandBuildingsAutomationWarning]"
											}
										}
									}

									vbox = {
										datacontext = "[BuildingCandidate.GetLocationToBuildItem]"
										visible = "[LocationToBuildItem.HasConstructedBuildingLevels]"
										spacing = 1
										datamodel = "[LocationToBuildItem.GetBuildingSlots]"
										item = {
											production_method_slot_circle = {}
										}
									}

									widget = { #efficiency
										size = { 70 -1 }
										layoutpolicy_vertical = expanding
										vbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											vbox = {
												visible = "[Building.IsProducing]"
												layoutpolicy_horizontal = expanding
												datamodel = "[Building.GetProductionMethods]"
												spacing = 2 # GlorpUI: 6->2 to fit ROI under two efficiency lines
												item = {
													text_single = {
														size = { 70 15 } # GlorpUI: {70 18} -> {70 15}
														autoresize = no
														#raw_text = "[Building.GetBuildingProductionEfficiency(ActiveProductionMethod.GetMethod)|+=2%]@efficiency!"
														text = "BUILDING_PROD_EFFICIENCY"
														align = nobaseline|right
														default_format = "@bold!"
														fontsize = 13 # GlorpUI: 14->13
														tooltipwidget = {
															using = building_production_efficiency_tooltip
														}

														using = bg_number_container_bckg
														blockoverride "number_container_extra" {
															margin = { 1 0 }
															margin_left = 0
														}

														sort_by_highlight = {
															size = { 105% 200% }
															name = "production_efficiency"
														}
													}
												}
											}
											hbox = {
												# GlorpUI: built ROI
												expand = { }
												text_single = {
													size = { 70 15 }
													autoresize = no
													align = nobaseline|right
													fontsize = 13
													default_format = "#color_green"
													visible = "[And3(GreaterThan_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Select_CFixedPoint(Player.MakeScope.GetVariable('roiUseProfit').IsSet, Building.GetProfitPerLevel, Building.GetIncomeToOwnerPerLevel), '(CFixedPoint)0'), Player.MakeScope.GetVariable('roiUseMonths').IsSet)]"
													text = "GLORP_UI_BL_ROI_MONTHS_VALUE"
													tooltipwidget = {
														using = glorpUI_building_roi_tooltip
													}
												}
												text_single = {
													size = { 70 15 }
													autoresize = no
													align = nobaseline|right
													fontsize = 13
													default_format = "#color_green"
													visible = "[And3(GreaterThan_CFixedPoint(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self), '(CFixedPoint)0'), GreaterThan_CFixedPoint(Select_CFixedPoint(Player.MakeScope.GetVariable('roiUseProfit').IsSet, Building.GetProfitPerLevel, Building.GetIncomeToOwnerPerLevel), '(CFixedPoint)0'), Not(Player.MakeScope.GetVariable('roiUseMonths').IsSet))]"
													text = "GLORP_UI_BL_ROI_YEARS_VALUE"
													tooltipwidget = {
														using = glorpUI_building_roi_tooltip
													}
												}
											}
											# hbox = {
											# 	margin_right = 2
											# 	margin_left = 12
											# 	progressbar_framed = {
											# 		visible = "[Building.GetHasEstablishmentRamp]"
